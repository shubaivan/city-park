{% extends 'base.html.twig' %}

{% block title %}Hello Admin!{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('simditor-2.3.28/styles/simditor.css') }}" />
{% endblock %}

{% block body %}
    {{ parent() }}

    {#
        Column titles. The keys are the entity's field names (TelegramUser::$dataTableFields)
        and were printed raw, so the accountant read "account_number", "is_active",
        "last_visit" — English identifiers in an otherwise Ukrainian panel. Anything not
        listed here falls back to its key, so adding a field cannot produce a blank header.

        Order and count must stay exactly as $dataTableFields: telegram_users.js targets
        every column by INDEX.
    #}
    {% set th_titles = {
        'id': '#',
        'account_number': 'Особовий рахунок',
        'apartment_number': 'Адреса',
        'house_number': 'Будинок',
        'street': 'Вулиця',
        'is_active': 'Статус',
        'debt': 'Борг',
        'area': 'Площа',
        'debt_threshold': 'Поріг боргу',
        'phone_number': 'Телефон',
        'additional_phones': 'Родичі',
        'first_name': 'Ім\'я',
        'last_name': 'Прізвище',
        'username': 'Telegram',
        'start': 'У боті з',
        'last_visit': 'Активність',
        'action': 'Дії',
        'role': 'Хто це',
        'vote_blocks': 'Блокувань голосуванням'
    } %}

    {% if th_keys|length %}
        <!-- Table -->

        <div class="mb-2">
            <a href="{{ path('app_admin_objects') }}" class="btn btn-sm btn-outline-secondary">🏢 Об'єкти нерухомості →</a>
        </div>

        <table id='telegramUserTable' class='display dataTable'>

            <thead>
            <tr>
                {% for th_key in th_keys %}
                    <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tfoot>
            {% for th_key in th_keys %}
                <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
            {% endfor %}
            </tfoot>

        </table>
    {% endif %}


{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('index/js/telegram_users.min') }}

    <script defer>
        console.log('getJSonObject');
        function getJSonObject(value) {
            return $.parseJSON(value.replace(/&quot;/ig, '"'));
        }

        let th_keys = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
        let for_prepare_defs = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
    </script >

    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/module.js') }}" defer></script>
    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/hotkeys.js') }}" defer></script>


    <script src="{{ asset('simditor-2.3.28/lib/simditor.js') }}" defer></script>


{% endblock %}

