{% extends 'base.html.twig' %}

{% block title %}Люди · ОСББ City Park{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('simditor-2.3.28/styles/simditor.css') }}" />
{% endblock %}

{% block body %}
    {#
        The face in the name cell. Small — 28px — because this is a table of 462 rows read
        on a phone as often as on a desktop, and the picture is here to be recognised in
        passing, not looked at. The full-size one is on the resident's card.
    #}
    <style>
        .tg-name { display: flex; align-items: center; gap: .5rem; }
        .tg-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            object-fit: cover; flex: 0 0 auto; background: #e9ecef;
        }
        .tg-initials {
            display: inline-flex; align-items: center; justify-content: center;
            font-size: .72rem; font-weight: 600; color: #fff;
        }

        /*
            The filter area, on a phone.

            This page is worked from a phone as often as from a desk, and next to
            /admin/objects — a plain search box and a row of chips — it looked broken:
            seven fixed-width labelled boxes taking the whole first screen and the filter
            buttons wrapped into a grid of square-cornered blocks. The chips and the
            DataTables chrome are fixed for both admin tables in base.html.twig; what is
            left here is this page's own field panel.
        */
        .users-filter-grid {
            display: grid;
            /* auto-fit: two boxes on a phone, all seven on a desktop, no breakpoints. */
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: .5rem;
            align-items: end;
        }
        .users-filter-grid input,
        .users-filter-grid select { width: 100%; }

        /* A <summary> styled as a button still shows the disclosure marker twice. */
        .users-field-details > summary { list-style: none; cursor: pointer; }
        .users-field-details > summary::-webkit-details-marker { display: none; }

        @media (min-width: 768px) {
            /* On a desktop the panel is simply always there — no button, no folding. */
            .users-field-details > summary { display: none; }
        }

    </style>

    {{ parent() }}

    {#
        Column titles. The keys are the entity's field names (TelegramUser::$dataTableFields)
        and were printed raw, so the accountant read "account_number", "is_active",
        "last_visit" — English identifiers in an otherwise Ukrainian panel. Anything not
        listed here falls back to its key, so adding a field cannot produce a blank header.

        Order and count must stay exactly as $dataTableFields: telegram_users.js targets
        every column by INDEX.
    #}
    {% set th_titles = {
        'id': '#',
        'account_number': 'Особовий рахунок',
        'apartment_number': 'Адреса',
        'house_number': 'Будинок',
        'street': 'Вулиця',
        'is_active': 'Статус',
        'debt': 'Борг',
        'area': 'Площа',
        'debt_threshold': 'Поріг боргу',
        'phone_number': 'Телефон',
        'additional_phones': 'Родичі',
        'first_name': 'Ім\'я',
        'last_name': 'Прізвище',
        'username': 'Telegram',
        'start': 'У боті з',
        'last_visit': 'Активність',
        'action': 'Дії',
        'role': 'Хто це',
        'vote_blocks': 'Блокувань голосуванням',
        'full_name': 'ПІБ за реєстром'
    } %}

    {#
        The page had no container at all: the table, the filters and the nav all started
        hard against the left edge of the screen. The objects register — the page this one
        is read next to — is a `container-fluid px-2 px-sm-3`, so it gets the same.
    #}
    {% if th_keys|length %}
        <!-- Table -->

        <div class="container-fluid mt-2 px-2 px-sm-3">

        <div class="mb-2">
            <a href="{{ path('app_admin_objects') }}" class="btn btn-sm btn-outline-secondary">🏢 Об'єкти нерухомості →</a>
        </div>

        <table id='telegramUserTable' class='display dataTable'>

            <thead>
            <tr>
                {% for th_key in th_keys %}
                    <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tfoot>
            {% for th_key in th_keys %}
                <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
            {% endfor %}
            </tfoot>

        </table>

        </div>
    {% endif %}


{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('index/js/telegram_users.min') }}

    <script>

        // The buildings that actually have accounts, so the filter row can never show an

        // empty one or miss a new one.

        window.adminHouses = {{ houses|json_encode|raw }};

    </script>

    <script defer>
        console.log('getJSonObject');
        function getJSonObject(value) {
            return $.parseJSON(value.replace(/&quot;/ig, '"'));
        }

        let th_keys = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
        let for_prepare_defs = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
    </script >

    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/module.js') }}" defer></script>
    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/hotkeys.js') }}" defer></script>


    <script src="{{ asset('simditor-2.3.28/lib/simditor.js') }}" defer></script>


{% endblock %}

