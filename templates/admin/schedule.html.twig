{% extends 'base.html.twig' %}

{% block title %}Бронювання · ОСББ City Park{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {#
        One line per dimension, each a wrapping .chip-row (base.html.twig) rather than a
        .btn-group. The four groups used to sit in one flex row: on a phone every one of
        them wrapped inside itself, and a wrapped .btn-group is a grid of square-cornered
        blocks with borders in the wrong places. The label is the fixed left edge, so the
        four rows read as four questions — період, дати, альтанка, статус.
    #}
    <style>
        #scheduleFilters .btn.active { box-shadow: inset 0 0 0 2px rgba(0,0,0,.25); }
        #scheduleFilters .filter-line { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
        #scheduleFilters .filter-line + .filter-line { margin-top: .5rem; }
        #scheduleFilters .filter-label { font-size: 12px; color: #6c757d; min-width: 3.5rem; }
        #scheduleFilters .date-inputs input { width: 140px; max-width: calc(50% - .5rem); }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container-fluid mt-3 px-2 px-sm-3">
        <h3 class="mb-3">📅 Бронювання</h3>

        <div id="scheduleFilters" class="mb-3 p-2 p-sm-3 bg-light rounded">
            <div class="filter-line">
                <span class="filter-label">Період:</span>
                <div class="chip-row">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="today">Сьогодні</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="this-week">Цей тиждень</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="last-week">Минулий тиждень</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="this-month">Цей місяць</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary active" data-preset="all">Усі</button>
                </div>
            </div>

            <div class="filter-line date-inputs">
                <span class="filter-label">Дати:</span>
                <input type="date" id="filterDateFrom" class="form-control form-control-sm" placeholder="з">
                <input type="date" id="filterDateTo" class="form-control form-control-sm" placeholder="до">
            </div>

            <div class="filter-line">
                <span class="filter-label">Альтанка:</span>
                <div class="chip-row">
                    <button type="button" class="btn btn-sm btn-outline-secondary active" data-pavilion="">Усі</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-pavilion="1">A1</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-pavilion="2">A2</button>
                </div>
            </div>

            <div class="filter-line">
                <span class="filter-label">Статус:</span>
                <div class="chip-row">
                    <button type="button" class="btn btn-sm btn-outline-secondary active" data-status="">Усі</button>
                    <button type="button" class="btn btn-sm btn-outline-success" data-status="uploaded">📷 Фото</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" data-status="pending">⏳ Очікує</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-status="blocked">⛔ Прострочено</button>
                    <button type="button" class="btn btn-sm btn-outline-dark" data-status="forgiven">✅ Закрито без фото</button>
                    <button type="button" class="btn btn-sm btn-outline-info" data-status="future">🕓 Майбутнє</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-status="legacy">📜 До правила</button>
                </div>
            </div>

            <div class="filter-line">
                <button type="button" id="filterReset" class="btn btn-sm btn-link pl-0">✖ Скинути</button>
            </div>
        </div>

        {#
            Same rule as /admin/users: the keys are ScheduledSet::$dataTableFields and were
            printed raw, so the page showed "account_number" and "photo_status" in an
            otherwise Ukrainian panel. Unlisted keys fall back to themselves, and the order
            must stay as the entity defines it — schedule.js targets columns by INDEX.
        #}
        {% set th_titles = {
            'id': '#',
            'account_number': 'Особовий рахунок',
            'apartment_number': 'Адреса',
            'house_number': 'Будинок',
            'street': 'Вулиця',
            'is_active': 'Статус',
            'phone_number': 'Телефон',
            'username': 'Telegram',
            'scheduled_at': 'Час бронювання',
            'pavilion': 'Альтанка',
            'photo_status': 'Фото',
            'vote_blocks': 'Блокувань голосуванням'
        } %}

        {% if th_keys|length %}
            <table id='telegramUserTable' class='display dataTable'>
                <thead>
                <tr>
                    {% for th_key in th_keys %}
                        <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tfoot>
                {% for th_key in th_keys %}
                    <th scope="col">{{ th_titles[th_key]|default(th_key) }}</th>
                {% endfor %}
                </tfoot>
            </table>
        {% endif %}
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('index/js/schedule.min') }}

    <script defer>
        function getJSonObject(value) {
            return $.parseJSON(value.replace(/&quot;/ig, '"'));
        }

        let th_keys = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
        let for_prepare_defs = getJSonObject("{{ dataTableKeys ? dataTableKeys|json_encode() : "{}" }}");
    </script>

    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/module.js') }}" defer></script>
    <script src="{{ asset('simditor-2.3.28/site/assets/scripts/hotkeys.js') }}" defer></script>
    <script src="{{ asset('simditor-2.3.28/lib/simditor.js') }}" defer></script>
{% endblock %}
