{% extends 'base.html.twig' %}

{% block title %}Панель · ОСББ City Park{% endblock %}

{% block body %}
    {{ parent() }}

    {#
        A directory of the panel, as cards.

        It was a table with «Management / Resource Name / Action» in English, rows numbered
        1, 1a, 2… and every link saying «Список» — so the only way to know what a section
        did was to open it. Each card now says what the page is for in one line, which is
        also what makes the panel usable by somebody who opens it twice a month.
    #}
    <style>
        .hub { max-width: 68rem; }
        .hub-grid { display: grid; grid-template-columns: 1fr; gap: .75rem; }
        @media (min-width: 576px) { .hub-grid { grid-template-columns: 1fr 1fr } }
        @media (min-width: 992px) { .hub-grid { grid-template-columns: 1fr 1fr 1fr } }
        .hub-card { display: block; color: inherit; text-decoration: none; height: 100%; }
        .hub-card:hover { text-decoration: none; color: inherit; box-shadow: 0 .25rem .6rem rgba(0,0,0,.09); }
        .hub-card .card-body { padding: .9rem 1rem; }
        .hub-emoji { font-size: 1.5rem; line-height: 1; }
        .hub-note { color: #6c757d; font-size: .84rem; }
        .hub-h { font-size: .8rem; letter-spacing: .04em; text-transform: uppercase; color: #6c757d; }
    </style>

    <div class="container-fluid mt-3 px-2 px-sm-3 hub">

        <h3 class="mb-3">Панель ОСББ «City Park»</h3>

        <div class="hub-h mb-2">Щоденне</div>
        <div class="hub-grid mb-4">
            <a class="card hub-card" href="{{ path('app_admin_users') }}">
                <div class="card-body">
                    <div class="hub-emoji">👤</div>
                    <b>Люди</b>
                    <div class="hub-note">Усі, хто відкривав бота. Пошук за телефоном, прізвищем, рахунком; картка мешканця з блокуванням і роллю.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_objects') }}">
                <div class="card-body">
                    <div class="hub-emoji">🏢</div>
                    <b>Об'єкти нерухомості</b>
                    <div class="hub-note">Квартири, паркомісця, комірчини: борг, власники, тип, об'єднання об'єктів одного власника.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_complaints') }}">
                <div class="card-body">
                    <div class="hub-emoji">🔧</div>
                    <b>Заявки</b>
                    <div class="hub-note">Що зламалось у будинку. Статуси, обговорення з автором, фото.</div>
                </div>
            </a>
        </div>

        <div class="hub-h mb-2">Гроші</div>
        <div class="hub-grid mb-4">
            <a class="card hub-card" href="{{ path('app_admin_debt') }}">
                <div class="card-body">
                    <div class="hub-emoji">💰</div>
                    <b>Борги</b>
                    <div class="hub-note">Завантаження файлу боргів. Показує, скільки рахунків із файлу бот не знає і на яку суму.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_area') }}">
                <div class="card-body">
                    <div class="hub-emoji">📐</div>
                    <b>Реєстр площ</b>
                    <div class="hub-note">Площі квартир одним файлом. Від площі залежить персональний поріг блокування.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_tariff') }}">
                <div class="card-body">
                    <div class="hub-emoji">💵</div>
                    <b>Тариф</b>
                    <div class="hub-note">Ціна за м². Разом із площею дає поріг: площа × тариф × 1.5.</div>
                </div>
            </a>
        </div>

        <div class="hub-h mb-2">Альтанка і мешканці</div>
        <div class="hub-grid mb-4">
            <a class="card hub-card" href="{{ path('app_admin_schedule') }}">
                <div class="card-body">
                    <div class="hub-emoji">📅</div>
                    <b>Бронювання</b>
                    <div class="hub-note">Хто і коли бронював альтанки.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_photo_requests') }}">
                <div class="card-body">
                    <div class="hub-emoji">📸</div>
                    <b>Запити на фото</b>
                    <div class="hub-note">Хто не надіслав фото після бронювання і кого через це заблоковано.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_block_votes') }}">
                <div class="card-body">
                    <div class="hub-emoji">🗳️</div>
                    <b>Голосування за блокування</b>
                    <div class="hub-note">Рішення спільноти заблокувати аккаунт на 30 днів.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_rentals') }}">
                <div class="card-body">
                    <div class="hub-emoji">🔑</div>
                    <b>Оренда квартир</b>
                    <div class="hub-note">Оголошення мешканців. Можна зняти з публікації.</div>
                </div>
            </a>

            <a class="card hub-card" href="{{ path('app_admin_guide') }}">
                <div class="card-body">
                    <div class="hub-emoji">📖</div>
                    <b>Інструкція</b>
                    <div class="hub-note">Як користуватись панеллю: покроково, з картинками.</div>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
