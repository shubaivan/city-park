{#
    One line of the guard's feed (GuardFeed): the page and the 10-second poll both draw it
    from here, so a row that arrives later looks exactly like one that was there.
    Plain text for the guard's login: nothing here may lead it to a page it is refused at.
#}
<tr class="feed-row feed-{{ item.type }}{% if fresh|default(false) %} feed-fresh{% endif %}" data-key="{{ item.key }}">
    <td class="feed-mark">
        {% if item.type == 'in' %}
            <span class="mark mark-in" title="В'їзд">➜</span><span class="mark-label text-success">В'їзд</span>
        {% elseif item.type == 'out' %}
            <span class="mark mark-out" title="Виїзд">➜</span><span class="mark-label text-danger">Виїзд</span>
        {% else %}
            <span class="mark mark-scan" title="Сканування QR">▣</span><span class="mark-label">QR</span>
        {% endif %}
    </td>
    <td class="feed-time">{{ item.at|date('H:i') }}</td>
    <td class="feed-who">
        <div class="who">
            {% if item.account_id and not guard_only|default(false) %}<a href="{{ path('app_admin_object', {id: item.account_id}) }}" class="text-decoration-none">{{ item.who }}</a>{% else %}{{ item.who }}{% endif %}
        </div>
        <div class="sub">
            {# A pass mark opens that pass's own feed — revoked and expired passes too (21.11.2026). #}{% if item.pass_id %}<a href="{{ path('app_admin_scans', {pass: item.pass_id}) }}#pass-filter" class="text-decoration-none">{{ item.kind }}</a>{% else %}{{ item.kind }}{% endif %}{% if item.place %} · {{ item.place }}{% endif %}
            {% if item.car %} · <span class="car">🚗 {{ item.car }}</span>{% endif %}
            {% if item.problem %} <span class="problem">{{ item.problem }}</span>{% endif %}
        </div>
        {#
            Who to ring (Иван, 21.11.2026): the pass's issuer — for a revoked or expired pass
            too, it is not in the live list above — or the people on the flat whose code it is. Mandatory on every line
            (Иван, 21.11.2026: the guard rings to clarify); «—» when there is nobody.
        #}
        {% if item.guest|default(false) %}
            <div class="contact">Видав: {{ include('admin/_contact_person.html.twig', {person: item.issuer|default(null), guard_only: guard_only|default(false)}) }}</div>
        {% else %}
            {# Every line has somebody to ring, or says there is nobody (an unrecognised code, a flat with no one linked). #}
            <div class="contact">Контакт: {% for person in item.contacts|default([]) %}{{ include('admin/_contact_person.html.twig', {person: person, guard_only: guard_only|default(false)}) }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}</div>
        {% endif %}
    </td>
    <td class="feed-by">
        {{ item.by }}{% if item.by_guard and item.type == 'scan' %} <span class="badge badge-dark">охорона</span>{% endif %}
    </td>
</tr>
