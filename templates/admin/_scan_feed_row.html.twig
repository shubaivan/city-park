{#
    One line of the guard's feed (GuardFeed): the page and the 10-second poll both draw it
    from here, so a row that arrives later looks exactly like one that was there.
    Plain text for the guard's login: nothing here may lead it to a page it is refused at —
    the filter links (`?pass=`, `?person=`) stay on this page and are fine for it.

    A row whose line names a pass or a person opens that one's feed when tapped anywhere
    outside a link (`data-href`, scans.html.twig) — 22.11.2026.
#}
{% set guard_only = guard_only|default(false) %}
{% set person_href = item.person_id|default(null) ? path('app_admin_scans', {person: item.person_id}) ~ '#person-filter' : null %}
{% set pass_href = item.pass_id ? path('app_admin_scans', {pass: item.pass_id}) ~ '#pass-filter' : null %}
{% set row_href = item.guest ? pass_href : person_href %}
{# A scan the bot refused (Иван, 23.11.2026): red mark, red line — never a quiet grey one. #}
{% set refused = item.type == 'scan' and item.problem %}
<tr class="feed-row feed-{{ item.type }}{% if refused %} feed-refused{% endif %}{% if fresh|default(false) %} feed-fresh{% endif %}{% if row_href %} feed-row-link{% endif %}" data-key="{{ item.key }}"{% if row_href %} data-href="{{ row_href }}"{% endif %}>
    <td class="feed-mark">
        {% if item.type == 'in' %}
            <span class="mark mark-in" title="В'їзд">➜</span><span class="mark-label text-success">В'їзд</span>
        {% elseif item.type == 'out' %}
            <span class="mark mark-out" title="Виїзд">➜</span><span class="mark-label text-danger">Виїзд</span>
        {% elseif item.guest %}
            {# A guest pass is not a resident's QR: its own mark, the pass's 👷. #}
            <span class="mark mark-scan mark-pass" title="Сканування пропуску">👷</span><span class="mark-label">Пропуск</span>
        {% else %}
            <span class="mark mark-scan" title="Сканування QR">▣</span><span class="mark-label">QR</span>
        {% endif %}
    </td>
    <td class="feed-time">{{ item.at|date('H:i') }}</td>
    <td class="feed-who">
        <div class="who">
            {% if item.account_id and not guard_only %}<a href="{{ path('app_admin_object', {id: item.account_id}) }}" class="text-decoration-none">{{ item.who }}</a>{% else %}{{ item.who }}{% endif %}
        </div>
        {% if item.guest %}
            {#
                The pass, readable without a click (Иван, 22.11.2026): which one, what for, the
                car, whether it runs right now, how often it was used. The number opens the
                pass's own feed — revoked and expired passes too (21.11.2026).
            #}
            {% set info = item.pass_info|default(null) %}
            <div class="sub pass-line">
                {% if pass_href %}<a href="{{ pass_href }}" class="pass-num">{{ item.kind }}</a>{% else %}<span class="pass-num">{{ item.kind }}</span>{% endif %}
                {% if info %}
                    {% if info.purpose %} · <b class="pass-purpose">{{ info.purpose }}</b>{% endif %}
                    {% if info.plate %} <span class="car-plate">{{ info.plate }}</span>{% endif %}
                    {# Refused for what the status says (expired, revoked): said once, as the refusal. #}
                    {% if item.refusal_is_status|default(false) %}<span class="problem">❌ {{ info.status_text }}</span>{% else %}<span class="pass-status pass-{{ info.status }}">{{ info.status_label }}</span>{% endif %}
                    <span class="pass-uses text-nowrap">· сканів: {{ info.scans }}</span>
                {% elseif item.pass_label|default('') %}
                    · <b class="pass-purpose">{{ item.pass_label }}</b>
                {% endif %}
                {% if item.place %} · {{ item.place }}{% endif %}
                {% if item.car %} · <span class="car">🚗 {{ item.car }}</span>{% endif %}
                {# What the scan answered then — unless the status above already said it. #}
                {% if item.problem and not item.refusal_is_status|default(false) %} <span class="problem">{{ item.problem }}</span>{% endif %}
            </div>
            {# Who to ring (Иван, 21.11.2026): the issuer, for a revoked or expired pass too. #}
            <div class="contact">Видав: {{ include('admin/_contact_person.html.twig', {person: item.issuer|default(null), guard_only: guard_only}) }}</div>
        {% else %}
            <div class="sub">
                {{ item.kind }}{% if item.place %} · {{ item.place }}{% endif %}
                {% if item.car %} · <span class="car">🚗 {{ item.car }}</span>{% endif %}
                {% if item.problem %} <span class="problem">{{ item.problem }}</span>{% endif %}
            </div>
            {#
                Whose code (22.11.2026): a personal code names its holder — name, role, phone —
                and the name filters the feed to that person. An old flat-level code says so.
            #}
            {% if item.person_label|default('') %}
                {% set p = item.person|default(null) %}
                <div class="person-line">
                    👤 {% if person_href %}<a href="{{ person_href }}" class="person-open">{{ p ? p|contact_name : item.person_label }}</a>{% else %}<b>{{ item.person_label }}</b>{% endif %}
                    {%- if p %} · <span class="person-role">{{ p.roleLabel }}</span>
                        {%- set phone = p|contact_phone %} · <span class="text-nowrap">📞 {% if phone != '—' %}<a href="tel:{{ phone }}">{{ phone }}</a>{% else %}—{% endif %}</span>
                        {%- if not guard_only %} <a href="{{ path('app_admin_resident', {id: p.id}) }}" class="small text-muted">картка</a>{% endif %}
                    {%- endif %}
                </div>
                <div class="contact">Інші з квартири: {% for person in item.contacts|default([]) %}{{ include('admin/_contact_person.html.twig', {person: person, guard_only: guard_only}) }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}</div>
            {% else %}
                {% if item.account_id and item.problem is null %}<div class="person-unknown">👤 хто саме — невідомо (старий код квартири)</div>{% endif %}
                {# Every line has somebody to ring, or says there is nobody (an unrecognised code, a flat with no one linked). #}
                <div class="contact">Контакт: {% for person in item.contacts|default([]) %}{{ include('admin/_contact_person.html.twig', {person: person, guard_only: guard_only}) }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}</div>
            {% endif %}
        {% endif %}
    </td>
    <td class="feed-by">
        {{ item.by }}{% if item.by_guard and item.type == 'scan' %} <span class="badge badge-dark">охорона</span>{% endif %}
    </td>
</tr>
