{% extends 'base.html.twig' %}

{% block title %}В'їзд і сканування · ОСББ City Park{% endblock %}

{#
    Who scanned whose code, and when.

    Read on a phone as often as on a desktop — this is the page somebody opens *after*
    something happened in the yard, and that happens away from a desk. Same shape as the
    sign-in log: a table that scrolls inside its own box, nothing to click, nothing to
    change.
#}
{% block body %}
    {{ parent() }}

    <div class="container-fluid py-3 px-2 px-sm-3" style="max-width: 1000px;">
        {#
            The gate's login (ROLE_GUARD) reads this page and nothing else, so nothing here
            may lead it elsewhere: no dashboard link, and the flat and the resident are
            plain text rather than links to cards it would only be refused at.
        #}
        {% set guard_only = is_granted('ROLE_GUARD') and not is_granted('ROLE_ADMIN') and not is_granted('ROLE_COMPLAINTS') %}
        {% set pass_filter = pass_filter|default(null) %}
        {% set pass = pass|default(null) %}
        {% set is_live = is_live|default(is_current_week) %}
        {% if not guard_only %}<p class="mb-2"><a href="{{ path('app_admin') }}">← На головну адмінки</a></p>{% endif %}

        <h4 class="mb-1">🚧 В'їзд, виїзд і сканування QR</h4>
        <p class="text-muted mb-3 feed-intro">
            <span class="mark mark-in">➜</span> в'їзд ·
            <span class="mark mark-out">➜</span> виїзд ·
            <span class="mark mark-scan">▣</span> QR мешканця,
            <span class="mark mark-scan mark-pass">👷</span> пропуск — без в'їзду чи виїзду;
            <span class="mark mark-scan mark-refused">▣</span> червоне — бот відмовив.
            Сканувати може будь-який підтверджений мешканець та охорона — тому цей журнал і ведеться.
        </p>

        {#
            The post's feed (GuardFeed, 20.11.2026): one week, newest first, by day. Only
            the current week tops itself up — an earlier week is history and does not change.
        #}
        {#
            A filtered feed — one pass (`?pass=`, 21.11.2026) or one person's personal code
            (`?person=`, 22.11.2026) — always says so at the top, with an obvious way back
            (Иван, 22.11.2026). Both are plain links, so the browser's Back works too.
        #}
        {% set person_filter = person_filter|default(null) %}
        {% if pass_filter %}
            {% set info = pass_info|default(null) %}
            <div class="feed-filter pass-filter mb-2" id="pass-filter">
                <div class="ff-chip">
                    <span class="ff-what">Показано: <b>👷 пропуск №{{ pass_filter }}</b></span>
                    <a class="ff-clear btn btn-dark" href="{{ path('app_admin_scans') }}">✕ Усі події</a>
                </div>
                {% if pass %}
                    <div class="pf-title">
                        {% if info and info.purpose %}<b>{{ info.purpose }}</b>{% elseif not info %}<b>{{ pass.label }}</b>{% endif %}
                        {% if info and info.plate %} <span class="car-plate">{{ info.plate }}</span>{% endif %}
                    </div>
                    <div class="pf-sub">
                        {{ pass.account ? pass.account.placeLabel : '—' }} ·
                        Видав: {{ include('admin/_contact_person.html.twig', {person: pass.issuedBy, guard_only: guard_only}) }}
                    </div>
                    <div class="pf-sub">
                        Створено {{ pass.createdAt|date('d.m.Y H:i') }} ·
                        {% if info %}<span class="pass-status pass-{{ info.status }}">{{ info.status_label }}</span> · сканів: {{ info.scans }}
                        {% elseif pass.revokedAt|default(null) %}🗑 скасований {{ pass.revokedAt|date('d.m H:i') }}
                        {% elseif pass.activeUntil and pass.activeUntil > now %}<span class="text-success">✅ активний до {{ pass.activeUntil|date('d.m H:i') }}</span>
                        {% else %}⚪️ не активний{% endif %}
                    </div>
                {% else %}
                    <div class="pf-title">Пропуск #{{ pass_filter }} — у базі його вже немає; нижче — його записи в журналі.</div>
                {% endif %}
            </div>
        {% elseif person_filter %}
            <div class="feed-filter person-filter mb-2" id="person-filter">
                <div class="ff-chip">
                    <span class="ff-what">Показано: <b>👤 {{ person ? person|contact_name : (person_label|default(null) ?: 'людина #' ~ person_filter) }}</b></span>
                    <a class="ff-clear btn btn-dark" href="{{ path('app_admin_scans') }}">✕ Усі події</a>
                </div>
                {% if person %}
                    <div class="pf-sub">
                        {{ person.account ? person.account.placeLabel : "вже не прив'язана до квартири" }} · {{ person.roleLabel }} ·
                        {% set phone = person|contact_phone %}📞 {% if phone != '—' %}<a href="tel:{{ phone }}">{{ phone }}</a>{% else %}—{% endif %}
                        {% if not guard_only %} · <a href="{{ path('app_admin_resident', {id: person.id}) }}">картка мешканця</a>{% endif %}
                    </div>
                {% else %}
                    <div class="pf-sub">У боті цієї людини вже немає; нижче — записи журналу з її кодом.</div>
                {% endif %}
                <div class="pf-sub text-muted small">Лише сканування особистого QR-коду цієї людини (старі коди квартири людину не називають).</div>
            </div>
        {% endif %}

        {% if calendar is defined %}{{ include('admin/_scan_calendar.html.twig') }}{% endif %}

        {% if not pass_filter and not person_filter %}
        <div class="feed-nav d-flex flex-wrap align-items-center mb-2">
            <a class="btn btn-outline-dark mr-2 mb-1" href="{{ path('app_admin_scans', {week: prev_week}) }}">← Попередній тиждень</a>
            <b class="mr-2 mb-1 feed-week">{{ is_current_week ? 'Цей тиждень' : 'Тиждень' }}: {{ week_label }}</b>
            {% if next_week %}
                <a class="btn btn-outline-dark mr-2 mb-1" href="{{ path('app_admin_scans', {week: next_week}) }}">Наступний тиждень →</a>
                <a class="btn btn-dark mb-1" href="{{ path('app_admin_scans') }}">До поточного</a>
            {% endif %}
        </div>
        {% endif %}

        {% if is_live %}
            <div id="feed-status" class="feed-status mb-2" aria-live="polite">
                Оновлюється автоматично · <span id="feed-updated">оновлено о {{ now|date('H:i:s', 'Europe/Kyiv') }}</span>
            </div>
            <div id="feed-alert" class="alert alert-warning feed-alert mb-2" style="display:none"></div>
        {% endif %}

        <div id="feed" class="guard-feed mb-4"
             data-live="{{ is_live ? '1' : '0' }}"
             data-week="{{ pass_filter ? 'pass' : (person_filter ? 'person' : week|date('Y-m-d')) }}"
             data-pass="{{ pass_filter|default('') }}"
             data-person="{{ person_filter|default('') }}"
             data-scan="{{ cursor.scan }}"
             data-event="{{ cursor.event }}"
             data-url="{{ path('app_admin_scans_feed') }}">
            {% for day in days %}
                {{ include('admin/_scan_feed_day.html.twig', {day: day, guard_only: guard_only}) }}
            {% endfor %}
            <div class="feed-empty text-muted p-3"{% if days is not empty %} style="display:none"{% endif %}>
                {% if pass_filter %}Цим пропуском ще не користувались.{% elseif person_filter %}Особистий код цієї людини ще не сканували.{% else %}{{ is_current_week ? 'Цього тижня ще нічого не було.' : 'Цього тижня нічого не було.' }}{% endif %}
                Охорона натискає «🚗 В'їзд» або «🚙 Виїзд» у боті після сканування QR.
            </div>
        </div>

        {#
            The live passes first: «які пропуски зараз ходять по ЖК» is the question this
            page is opened with more often than «хто сканував».
        #}
        <div class="card mb-3">
            <div class="card-header py-2 px-3"><b>👷 Діючі пропуски</b> <span class="text-muted small">— видані квартирами для бригад, доставок, майстрів</span></div>
            <div class="card-body p-0">
                {% if passes is empty %}
                    <div class="p-3 small text-muted mb-0">Жодна квартира ще не видавала пропусків.</div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small">
                            <thead>
                            <tr>
                                <th>Кого чекають</th>
                                <th>Квартира</th>
                                <th>Створено</th>
                                <th>Діє до</th>
                                <th>Сканів</th>
                                <th>Востаннє</th>
                                <th>Видав</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for pass in passes %}
                                {#
                                    The row the log links to. `:target` in base.html.twig
                                    flashes it — a scroll position on its own says nothing
                                    about which of a dozen near-identical lines was meant.
                                #}
                                {# The whole row opens the pass's own feed (21.11.2026); the links inside it keep their own targets. #}
                                <tr id="pass-{{ pass.id }}" class="pass-row{% if pass.id == pass_filter|default(null) %} pass-row-current{% endif %}" data-href="{{ path('app_admin_scans', {pass: pass.id}) }}#pass-filter">
                                    <td><a href="{{ path('app_admin_scans', {pass: pass.id}) }}#pass-filter" class="pass-open">{{ pass.label }}</a></td>
                                    <td>
                                        {% if pass.account and pass.account.id and not guard_only %}<a href="{{ path('app_admin_object', {id: pass.account.id}) }}" class="text-decoration-none">{{ pass.account.placeLabel }}</a>{% else %}{{ pass.account ? pass.account.placeLabel : '—' }}{% endif %}
                                    </td>
                                    <td class="text-muted">{{ pass.createdAt|date('d.m H:i') }}</td>
                                    <td>
                                        {% if pass.activeUntil and pass.activeUntil > now %}
                                            {# The date too: since 18.11.2026 a pass can run up to a week, and «до 23:59» alone reads as tonight. #}
                                            <span class="text-success">✅ активний до {{ pass.activeUntil|date('d.m H:i') }}</span>
                                        {% else %}
                                            <span class="text-muted">⚪️ ні</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ pass.scans }}</td>
                                    <td class="text-muted">{{ pass.lastScannedAt ? pass.lastScannedAt|date('d.m H:i') : '—' }}</td>
                                    <td class="text-muted">
                                        {# The resident's card: where they live, their phone, who else is on the flat. #}
                                        {#
                                            The issuer's phone, for everybody who reads this page
                                            (Иван, 12.11.2026): the guard rings the flat when
                                            something is wrong with a crew. One view, no role rule.
                                        #}
                                        {{ include('admin/_contact_person.html.twig', {person: pass.issuedBy, guard_only: guard_only}) }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if is_live %}
            <template id="feed-day-template">{{ include('admin/_scan_feed_day.html.twig', {day: {date: '', label: '', items: [], in: 0, out: 0, scans: 0}, guard_only: guard_only}) }}</template>
        {% endif %}
    </div>

    {#
        Built for the post's old PC, kept open all day: big type, strong contrast, the
        arrows readable from a step away. In = green arrow pointing in, out = red arrow
        pointing back out, a plain scan = grey square.
    #}
    <style>
        .guard-feed { font-size: 1.15rem; }
        .feed-intro { font-size: 1rem; }
        .feed-nav .btn { font-size: 1.05rem; }
        .feed-week { font-size: 1.15rem; }
        .feed-status { font-size: 1rem; color: #333; }
        .feed-alert { font-size: 1.1rem; font-weight: 600; }
        .feed-day-counts .text-success { color: #0a7a2f !important; }
        .feed-day-counts .text-danger { color: #c4141b !important; }
        .mark-out-inline { display: inline-block; transform: scaleX(-1); }
        .feed-table th { font-size: .95rem; color: #444; border-top: 0; }
        .feed-table td { vertical-align: middle; border-top: 1px solid #ccc; color: #111; }
        .feed-mark { white-space: nowrap; width: 8.5rem; }
        .mark { display: inline-block; width: 2.2rem; height: 2.2rem; line-height: 2.2rem; text-align: center; border-radius: 50%; font-size: 1.4rem; font-weight: 900; color: #fff; margin-right: .4rem; vertical-align: middle; }
        .feed-intro .mark { width: 1.6rem; height: 1.6rem; line-height: 1.6rem; font-size: 1rem; margin-right: .1rem; }
        .mark-in { background: #0a7a2f; }
        .mark-out { background: #c4141b; transform: scaleX(-1); }
        .mark-scan { background: #6c757d; font-size: 1.1rem; }
        .mark-pass { font-size: 1.3rem; }
        .mark-label { font-weight: 700; vertical-align: middle; }
        .mark-label.text-success { color: #0a7a2f !important; }
        .mark-label.text-danger { color: #c4141b !important; }
        .feed-in { background: #effaf2; }
        .feed-out { background: #fdf0f0; }
        .feed-time { font-size: 1.35rem; font-weight: 700; white-space: nowrap; width: 5rem; }
        .feed-who .who { font-weight: 700; }
        .feed-who .sub { font-size: 1rem; color: #333; }
        .feed-who .car { font-weight: 700; white-space: nowrap; }
        /* A refusal (23.11.2026): red, bold, framed — the first thing read on its line. */
        .feed-who .problem { display: inline-block; margin-left: .3rem; padding: 0 .4rem; border: 1px solid #c4141b; border-radius: 4px; background: #fde4e4; color: #b0000f; font-weight: 800; }
        .feed-refused { box-shadow: inset 6px 0 0 #c4141b; }
        .feed-refused .mark-scan, .mark-scan.mark-refused { background: #c4141b; }
        .feed-refused .mark-label { color: #c4141b; }
        .feed-who .contact { font-size: 1rem; color: #333; }
        .pass-row { cursor: pointer; }
        .pass-row:hover { background: #f1f6ff; }
        .pass-row-current { background: #e3efff; }
        .pass-open { font-weight: 700; }
        .feed-filter { font-size: 1.05rem; color: #0c3c5e; background: #e3efff; border: 2px solid #1d5fa3; border-radius: 6px; padding: .5rem .75rem; }
        .feed-filter .ff-chip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem; }
        .feed-filter .ff-what { font-size: 1.2rem; }
        .feed-filter .ff-clear { font-size: 1.05rem; font-weight: 700; white-space: nowrap; }
        .feed-filter .pf-title { font-size: 1.15rem; margin-top: .3rem; }
        .feed-row-link { cursor: pointer; }
        .feed-row-link:hover td { background-color: rgba(29, 95, 163, .06); }
        .feed-who .pass-line { line-height: 1.6; }
        .feed-who .pass-num { font-weight: 700; white-space: nowrap; }
        .feed-who .pass-purpose { font-weight: 700; color: #111; }
        .feed-who .pass-status { display: inline-block; white-space: nowrap; padding: 0 .35rem; border-radius: 4px; font-size: .95rem; }
        .pass-status.pass-active { background: #d8f3df; color: #0a5a22; }
        .pass-status.pass-inactive { background: #eceef0; color: #444; }
        .pass-status.pass-revoked { background: #fbe0e0; color: #8a1016; }
        .feed-who .pass-uses { font-size: .95rem; color: #444; }
        .feed-who .car-plate { font-size: .95rem; }
        .feed-who .person-line { font-size: 1.05rem; }
        .feed-who .person-open { font-weight: 700; }
        .feed-who .person-role { color: #333; }
        .feed-who .person-unknown { font-size: .95rem; color: #666; font-style: italic; }
        .scan-cal { max-width: 26rem; }
        .scan-cal-head { display: flex; align-items: center; justify-content: space-between; padding: .35rem .5rem; }
        .scan-cal-title { font-size: 1.1rem; }
        .scan-cal-nav { display: inline-block; min-width: 2.6rem; text-align: center; font-size: 1.5rem; line-height: 2.2rem; border: 1px solid #ccc; border-radius: 6px; text-decoration: none !important; color: #111; }
        .scan-cal-nav.disabled { color: #bbb; }
        .scan-cal-grid { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 3px; }
        .scan-cal-grid th { text-align: center; font-size: .8rem; color: #555; font-weight: 600; }
        .scan-cal-grid td { text-align: center; height: 2.7rem; border-radius: 5px; padding: 0; vertical-align: middle; }
        .scan-cal-grid td a { display: block; height: 100%; color: inherit; text-decoration: none; padding-top: .15rem; }
        .scan-cal-grid .wk { width: 1.9rem; }
        .scan-cal-grid td.wk a { font-weight: 700; color: #333; padding-top: .55rem; }
        .scan-cal-grid .dn { display: block; font-size: .75rem; line-height: 1rem; }
        .scan-cal-grid .dc { display: block; font-size: 1rem; font-weight: 800; line-height: 1.2rem; min-height: 1.2rem; }
        .scan-cal-grid .lvl-0 { background: #f3f4f6; color: #555; }
        .scan-cal-grid .lvl-1 { background: #d6e9fb; color: #0b2e4f; }
        .scan-cal-grid .lvl-2 { background: #9fcbf3; color: #0b2e4f; }
        .scan-cal-grid .lvl-3 { background: #4a98de; color: #fff; }
        .scan-cal-grid .lvl-4 { background: #1d5fa3; color: #fff; }
        .scan-cal-grid .today { box-shadow: inset 0 0 0 2px #f0a500; }
        .scan-cal-grid .future { background: transparent; color: #bbb; }
        .scan-cal-grid .out { background: transparent; }
        .scan-cal-grid tr.shown-week td:not(.out) { outline: 2px solid #222; outline-offset: -1px; }
        .feed-day { scroll-margin-top: .5rem; }
        .feed-by { font-size: 1rem; color: #333; }
        @keyframes feed-flash { from { box-shadow: inset 6px 0 0 #f0a500; background-color: #fff3c4; } to { box-shadow: inset 6px 0 0 transparent; } }
        .feed-fresh { animation: feed-flash 12s ease-out 1; }
        @media (max-width: 576px) { .feed-mark .mark-label, .feed-table thead { display: none; } .feed-mark { width: auto; } .feed-day-counts { float: none; display: inline-block; margin-top: .25rem; } }
        /* Phone (22.11.2026): a line is a card — mark and time on top, who/pass under it, who checked last; no sideways scroll. */
        @media (max-width: 576px) {
            .feed-table, .feed-table tbody, .feed-table tr { display: block; width: 100%; }
            .feed-table tr.feed-row { border-top: 1px solid #ccc; padding: .45rem .6rem; }
            .feed-table td { display: inline-block; border: 0 !important; padding: 0; vertical-align: middle; }
            .feed-table td.feed-mark { margin-right: .3rem; }
            .feed-table td.feed-time { width: auto; font-size: 1.25rem; }
            .feed-table td.feed-who, .feed-table td.feed-by { display: block; margin-top: .2rem; }
            .feed-table td.feed-by { font-size: .95rem; color: #555; }
            .feed-table td.feed-by::before { content: 'Перевіряв: '; }
            .feed-who .pass-status { white-space: normal; }
            .feed-refused .feed-mark .mark-label { display: inline; }
            .guard-feed { font-size: 1.05rem; }
        }
        /* Days (Иван, 22.11.2026): a light grey strip, small caps, that stays on top while its day scrolls by. */
        .feed-day { margin-bottom: 1rem; border: 1px solid #dee2e6; border-radius: 6px; background: #fff; }
        .feed-day-title { position: sticky; top: 0; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .75rem; margin: 0; padding: .35rem .75rem; background: #f1f3f5; color: #495057; border-bottom: 1px solid #dee2e6; border-radius: 6px 6px 0 0; font-size: .9rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
        .feed-day-counts { float: none; margin: 0 0 0 auto; text-transform: none; letter-spacing: 0; font-size: .95rem; font-weight: 500; color: #555; }
        .feed-day ~ .feed-day .feed-table thead { display: none; }
        .feed-day ~ .feed-day .feed-table tbody tr:first-child, .feed-day ~ .feed-day .feed-table tbody tr:first-child td { border-top: 0; }
    </style>

    {#
        The 10-second top-up of the current week. Only what is newer than the ids already
        on the screen is asked for; paused while the tab is hidden, resumed (at once) on
        focus. A dropped network or an ended session never blanks the page: the rows stay,
        and a yellow line says what is wrong and what to do.
    #}
    <script>
    (function () {
        // A pass row opens the pass's own feed; a tap on a link inside it keeps its own target.
        document.querySelectorAll('tr.pass-row[data-href]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('a')) { return; }
                location.href = row.dataset.href;
            });
        });
        // A feed line naming a pass or a person opens that one's feed (22.11.2026). Delegated,
        // so lines the poll adds later behave the same; a tap on a link keeps its own target.
        var feedBox = document.getElementById('feed');
        if (feedBox) {
            feedBox.addEventListener('click', function (e) {
                if (e.target.closest('a, button')) { return; }
                var row = e.target.closest('tr.feed-row[data-href]');
                if (row && window.getSelection && String(window.getSelection()) === '') { location.href = row.dataset.href; }
            });
        }
        // A calendar day with nothing on it has no section to land on — land on the feed.
        // After load: the browser's own jump to a missing anchor would undo an earlier scroll.
        window.addEventListener('load', function () {
            if (/^#day-/.test(location.hash) && !document.getElementById(location.hash.slice(1))) {
                var f = document.getElementById('feed'); if (f) { setTimeout(function () { f.scrollIntoView(); }, 0); }
            }
        });
    })();
    (function () {
        var feed = document.getElementById('feed');
        if (!feed || feed.dataset.live !== '1' || window.__guardFeedStarted) { return; }
        window.__guardFeedStarted = true;

        var EVERY = 10000, SLOW = 30000;
        var cursor = { scan: +feed.dataset.scan || 0, event: +feed.dataset.event || 0 };
        var timer = null, busy = false, failures = 0;
        var alertBox = document.getElementById('feed-alert');
        var updated = document.getElementById('feed-updated');

        function warn(html) { alertBox.innerHTML = html; alertBox.style.display = ''; }
        function clearWarn() { alertBox.style.display = 'none'; }

        function bump(section, type, delta) {
            var el = section && section.querySelector(type === 'in' ? '.c-in' : (type === 'out' ? '.c-out' : '.c-scan'));
            if (el) { el.textContent = Math.max(0, (+el.textContent || 0) + delta); }
        }

        function daySection(day, label) {
            var section = feed.querySelector('.feed-day[data-day="' + day + '"]');
            if (section) { return section; }
            var tpl = document.getElementById('feed-day-template');
            var holder = document.createElement('div');
            holder.innerHTML = tpl.innerHTML.trim();
            section = holder.firstElementChild;
            section.setAttribute('data-day', day);
            section.id = 'day-' + day;
            section.querySelector('.feed-day-label').textContent = label;
            feed.insertBefore(section, feed.firstElementChild);
            return section;
        }

        /*
            Today's calendar cell grows with the poll (Иван, 21.11.2026), by the calendar's own
            rule: a new line is +1 on its day; a press that replaces a scan already on the
            screen is −1 on that scan's day, so «scan, then В'їзд» stays one event. A day
            outside the shown month has no cell, and nothing happens. The heat level is
            recounted against the month's busiest day, exactly as GuardCalendar::grid() does.
        */
        var calCells = {};
        document.querySelectorAll('.scan-cal-grid td[data-date]').forEach(function (td) { calCells[td.dataset.date] = td; });

        function calBump(date, delta) {
            var td = calCells[date];
            if (!td) { return; }
            var total = Math.max(0, (+td.dataset.total || 0) + delta);
            td.dataset.total = total;
            var dc = td.querySelector('.dc');
            if (dc) { dc.textContent = total > 0 ? total : ''; }
            var link = td.querySelector('a');
            if (link) { link.title = total + ' ' + (total === 1 ? 'подія' : 'подій'); }
            var max = 0, date2;
            for (date2 in calCells) { max = Math.max(max, +calCells[date2].dataset.total || 0); }
            for (date2 in calCells) {
                var cell = calCells[date2], t = +cell.dataset.total || 0;
                var level = t === 0 ? 0 : Math.max(1, Math.ceil(4 * t / max));
                cell.className = cell.className.replace(/\blvl-\d\b/, 'lvl-' + level);
            }
        }

        function apply(rows) {
            rows.forEach(function (row) {
                if (feed.querySelector('tr[data-key="' + row.key + '"]')) { return; }
                if (row.replaces) {
                    var old = feed.querySelector('tr[data-key="' + row.replaces + '"]');
                    if (old) {
                        var oldSection = old.closest('.feed-day');
                        bump(oldSection, 'scan', -1);
                        if (oldSection) { calBump(oldSection.dataset.day, -1); }
                        old.parentNode.removeChild(old);
                    }
                }
                calBump(row.day, 1);
                var section = daySection(row.day, row.day_label);
                var body = section.querySelector('tbody');
                var holder = document.createElement('tbody');
                holder.innerHTML = row.html.trim();
                body.insertBefore(holder.firstElementChild, body.firstElementChild);
                bump(section, row.type, 1);
            });
            if (rows.length) { var empty = feed.querySelector('.feed-empty'); if (empty) { empty.style.display = 'none'; } }
        }

        function schedule(ms) { clearTimeout(timer); if (!document.hidden) { timer = setTimeout(poll, ms); } }

        function poll() {
            if (busy || document.hidden) { return; }
            busy = true;
            var url = feed.dataset.url + '?scan=' + cursor.scan + '&event=' + cursor.event + (feed.dataset.pass ? '&pass=' + encodeURIComponent(feed.dataset.pass) : '') + (feed.dataset.person ? '&person=' + encodeURIComponent(feed.dataset.person) : '');
            fetch(url, { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (res) {
                    var type = res.headers.get('Content-Type') || '';
                    if (res.redirected || res.status === 401 || res.status === 403 || type.indexOf('application/json') === -1) {
                        var e = new Error('session'); e.session = true; throw e;
                    }
                    if (!res.ok) { throw new Error('http ' + res.status); }
                    return res.json();
                })
                .then(function (data) {
                    if (data.week !== feed.dataset.week) { location.href = location.pathname; return; }
                    apply(data.rows || []);
                    cursor = data.cursor || cursor;
                    failures = 0;
                    clearWarn();
                    // The server's Kyiv time, never the browser's clock: the post's PC may be set to UTC.
                    if (data.now) { updated.textContent = 'оновлено о ' + data.now; }
                    schedule(EVERY);
                })
                .catch(function (err) {
                    failures++;
                    if (err && err.session) {
                        warn('🔒 Сесію завершено — нові записи не надходять. Відкрийте бот → «🔐 Вхід у панель», щоб увійти знову. Записи нижче — станом на ' + updated.textContent.replace('оновлено о ', '') + '.');
                    } else {
                        warn('📡 Немає зв\'язку із сервером — повторюю спробу… Записи нижче — станом на ' + updated.textContent.replace('оновлено о ', '') + '.');
                    }
                    schedule(failures > 3 ? SLOW : EVERY);
                })
                .then(function () { busy = false; }, function () { busy = false; });
        }

        document.addEventListener('visibilitychange', function () {
            if (document.hidden) { clearTimeout(timer); } else { poll(); }
        });
        window.addEventListener('focus', function () { if (!busy) { poll(); } });
        window.addEventListener('online', function () { poll(); });
        schedule(EVERY);
    })();
    </script>
{% endblock %}
