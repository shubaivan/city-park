{% extends 'base.html.twig' %}

{% block title %}Боржники{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container mt-4">
        <h3>Завантаження файлу боржників</h3>

        <div class="alert alert-info">
            <p class="mb-2"><b>Формат файлу .xlsx</b> — дані починаються з <b>3-го рядка</b>, рядок 1 — заголовок, рядок 2 — назви колонок.</p>
            <table class="table table-bordered table-sm mb-2" style="max-width:480px;background:#fff">
                <thead>
                <tr class="table-light">
                    <th style="width:48px">#</th>
                    <th>A — № кв.</th>
                    <th>B — Особ. рах.</th>
                    <th>C — Борг</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td class="text-muted">3</td>
                    <td>74</td>
                    <td>1010074</td>
                    <td>1350.50</td>
                </tr>
                </tbody>
            </table>
            <p class="mb-2 text-muted">
                Площа квартир оновлюється окремо — через <a href="{{ path('app_admin_area') }}">/admin/area</a> (один реєстр на всі акаунти).
            </p>
            <a href="{{ path('app_admin_debt_example') }}" class="btn btn-sm btn-outline-primary">
                ⬇️ Завантажити приклад .xlsx
            </a>
        </div>

        <form action="{{ path('app_admin_debt_upload') }}" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="debt_file">Файл боржників (.xlsx)</label>
                <input type="file" class="form-control-file" id="debt_file" name="debt_file" accept=".xlsx" required>
            </div>
            <button type="submit" class="btn btn-primary">Завантажити та оновити</button>
        </form>

        {% if result is defined %}
            <div class="mt-4">
                <div class="alert alert-{{ result.success ? 'success' : 'danger' }}">
                    <h5>Результат:</h5>
                    <ul>
                        <li>Оброблено рядків: {{ result.processed }}</li>
                        <li>Оновлено акаунтів: {{ result.updated }}</li>
                        <li>Заблоковано (борг більший за персональний поріг квартири): <b style="color:red">{{ result.blocked }}</b></li>
                        <li>Скинуто борг (не в файлі): <b style="color:green">{{ result.reset }}</b></li>
                        <li>Не знайдено в базі: {{ result.not_found }}</li>
                        {% if result.announced is defined %}
                            <li>Анонс у чаті мешканців:
                                {% if result.announced == 'sent' %}
                                    <b style="color:green">опубліковано</b>
                                {% elseif result.announced == 'skipped:already-today' %}
                                    <span style="color:#888">сьогодні вже виходив</span>
                                {% elseif result.announced == 'skipped:not-configured' %}
                                    <span style="color:#888">чат не налаштовано</span>
                                {% else %}
                                    <b style="color:red">не вдалося — див. лог</b>
                                {% endif %}
                            </li>
                        {% endif %}
                    </ul>
                    {% if result.missing|length > 0 %}
                        {#
                            These rows are in the ОСББ's file and have no account in the
                            bot, so their debt is simply absent from everything the bot
                            publishes — the board, the chat post, the house total. The sum
                            is what says how far the published figure is from the books.
                        #}
                        <div class="alert alert-warning py-2 px-2 mb-2">
                            У файлі є <b>{{ result.missing|length }}</b> рахунків, яких немає в базі бота
                            {% if result.missing_debt is defined and result.missing_debt > 0 %}
                                — на <b>{{ result.missing_debt|number_format(2, '.', ' ') }} грн</b> боргу.
                            {% endif %}
                            <br>
                            <small>
                                Цих грошей немає ні в дошці боржників, ні в оголошенні в чаті: бот рахує
                                лише за своїми рахунками. Щоб вони потрапили у звіт — їх треба завести
                                в базу (реєстр площ, <a href="{{ path('app_admin_area') }}">/admin/area</a>).
                            </small>
                        </div>
                        <details>
                            <summary>Показати ці рахунки ({{ result.missing|length }})</summary>
                            <ul class="mb-0">
                                {% for acc, debt in result.missing %}
                                    <li>{{ acc }}{% if debt is not empty %} — {{ debt|number_format(2, '.', ' ') }} грн{% endif %}</li>
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {#
            The archive. Until 04.09.2026 the uploaded spreadsheet was read from PHP's
            temporary path and dropped with the request: `account.debt` is overwritten in
            place, DebtSnapshot keeps only the totals, and the audit log remembers a figure
            only for accounts that crossed a block threshold that day. So the evidence
            behind numbers the bot publishes to the whole house lived in one person's
            Telegram history.
        #}
        <div class="mt-4">
            <h5>📁 Архів завантажень</h5>
            <p class="text-muted mb-2">
                <small>Кожен файл зберігається як є. Це єдина копія того, на підставі чого
                    бот рахував борги того дня.</small>
            </p>

            {# Shown even when empty: an archive that appears only once it has something in
               it is indistinguishable from no archive at all, and the first question after
               a deploy is "а воно взагалі працює?". #}
            {% if archive is not defined or archive|length == 0 %}
                <p class="text-muted"><small>Поки що порожньо — сюди потрапить файл із наступного завантаження.</small></p>
            {% else %}
                <table class="table table-sm table-striped" style="max-width:640px">
                    <thead>
                    <tr>
                        <th>Коли</th>
                        <th>Хто</th>
                        <th>Розмір</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in archive %}
                        <tr>
                            <td>{{ item.uploaded_at|date('d.m.Y H:i') }}</td>
                            <td>{{ item.actor }}</td>
                            <td>{{ (item.size / 1024)|round }} КБ</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="{{ path('app_admin_import_archive_download', {kind: 'debt', name: item.name}) }}">
                                    ⬇️ Завантажити
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

{% endblock %}
