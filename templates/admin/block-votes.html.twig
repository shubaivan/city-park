{% extends 'base.html.twig' %}

{#
    Who voted which way, in two columns rather than one mixed run.

    The mixed list is unreadable at 40 ballots: the question an admin opens this with is
    «хто проти», and answering it meant scanning green and grey badges one by one. Each
    side is sorted by особовий рахунок so the same flat sits in the same place every time.
#}
{% macro ballots(list, withTime) %}
    {% set yes = list|filter(b => b.value)|sort((a, b) => a.voterAccount.accountNumber <=> b.voterAccount.accountNumber) %}
    {% set no  = list|filter(b => not b.value)|sort((a, b) => a.voterAccount.accountNumber <=> b.voterAccount.accountNumber) %}
    <div class="row">
        <div class="col-md-6 mb-2">
            <small class="text-muted">👍 За — {{ yes|length }}:</small><br>
            {% for b in yes %}
                <span class="badge badge-success mr-1 mb-1">
                    {{ b.voterAccount.unitLabel }}
                    {%- if b.voterUser %} · {{ b.voterUser.displayName }}
                        {%- if b.voterUser.username %} (@{{ b.voterUser.username }}){% endif %}
                    {%- endif %}
                    {%- if withTime and b.castAt %} · {{ b.castAt|date('d.m H:i') }}{% endif %}
                </span>
            {% else %}
                <small class="text-muted">—</small>
            {% endfor %}
        </div>
        <div class="col-md-6 mb-2">
            <small class="text-muted">👎 Проти — {{ no|length }}:</small><br>
            {% for b in no %}
                <span class="badge badge-secondary mr-1 mb-1">
                    {{ b.voterAccount.unitLabel }}
                    {%- if b.voterUser %} · {{ b.voterUser.displayName }}
                        {%- if b.voterUser.username %} (@{{ b.voterUser.username }}){% endif %}
                    {%- endif %}
                    {%- if withTime and b.castAt %} · {{ b.castAt|date('d.m H:i') }}{% endif %}
                </span>
            {% else %}
                <small class="text-muted">—</small>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% import _self as ballotBox %}

{% block title %}Голосування за блокування · ОСББ City Park{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container">
        <h3 class="mt-3">🗳️ Голосування спільноти</h3>
        <p class="text-muted">
            Адмін відкриває голосування для кандидата (за особовим рахунком). Голосують власники
            квартир та паркомісць (зокрема із боргом чи блоком), крім самого кандидата. Якщо «За»
            проголосує понад 30%, аккаунт автоматично блокується на {{ block_days }} днів
            (потім — авто-розблокування). Голосування триває {{ vote_days }} днів.
        </p>

        <div class="card my-3">
            <div class="card-header">Відкрити нове голосування</div>
            <div class="card-body">
                <form method="get" action="{{ path('app_admin_block_votes') }}" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label" for="candidate">Особовий рахунок кандидата</label>
                        <input type="text" class="form-control" id="candidate" name="candidate"
                               value="{{ preview.account_number ?? '' }}" placeholder="напр. 230109" required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Переглянути кандидата →</button>
                    </div>
                </form>
                <small class="form-text text-muted">Спочатку перевірте, кого саме виносите на голосування, і лише потім підтвердьте.</small>
            </div>
        </div>

        {% if preview %}
            {% if not preview.found %}
                <div class="alert alert-danger">
                    Аккаунт з особовим рахунком «<b>{{ preview.account_number }}</b>» не знайдено. Перевірте номер.
                </div>
            {% else %}
                <div class="card my-3 border-danger">
                    <div class="card-header bg-danger text-white">Підтвердження: кого виносимо на голосування</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-3" style="max-width:680px">
                                <tr><th style="width:220px">Кандидат</th><td><b>{{ preview.label }}</b></td></tr>
                                <tr><th>Особовий рахунок</th><td>{{ preview.account_number }}</td></tr>
                                <tr><th>Адреса</th><td>{{ preview.street }}, буд. {{ preview.house_number }}, кв. {{ preview.apartment_number }}</td></tr>
                                <tr><th>Остання бронь альтанки</th><td>{{ preview.last_booking ?? '—' }}</td></tr>
                                <tr><th>Жильці (Telegram)</th><td>
                                    {% if preview.names is empty %}
                                        <span class="text-muted">немає прив'язаних користувачів бота</span>
                                    {% else %}
                                        {% for n in preview.names %}{{ n }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                                    {% endif %}
                                </td></tr>
                                <tr><th>Поточний статус</th><td>
                                    {% if preview.is_active %}<span class="badge badge-success">Активний</span>
                                    {% else %}<span class="badge badge-secondary">Заблокований</span>{% endif %}
                                </td></tr>
                                <tr><th>Блокувань голосуванням</th><td>
                                    {% if preview.vote_block_count > 0 %}<span class="badge bg-warning text-dark">{{ preview.vote_block_count }}×</span>{% else %}0{% endif %}
                                </td></tr>
                                <tr><th>Голосуватимуть</th><td><b>{{ preview.eligible }}</b> квартир та паркомісць · потрібно «За»: <b>{{ preview.needed }}</b></td></tr>
                            </table>
                        </div>

                        {% if not preview.is_apartment %}
                            <div class="alert alert-warning py-2">Увага: це не квартира (паркомісце/кладова). Голосувати за нього зможуть лише квартири.</div>
                        {% endif %}

                        {% if preview.already_open %}
                            <div class="alert alert-warning py-2 mb-0">Для цього аккаунта вже відкрите голосування — нове відкрити не можна.</div>
                        {% else %}
                            <form method="post" action="{{ path('app_admin_block_vote_create') }}"
                                  onsubmit="return confirm('Відкрити голосування за блокування: {{ preview.label }}? Усі квартири та паркомісця ({{ preview.eligible }}) одразу отримають повідомлення.');">
                                <input type="hidden" name="account_number" value="{{ preview.account_number }}">
                                <button type="submit" class="btn btn-danger">✅ Так, відкрити голосування</button>
                                <a href="{{ path('app_admin_block_votes') }}" class="btn btn-link">Скасувати</a>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <h5>Активні голосування</h5>
        {% if open is empty %}
            <p class="text-muted">Немає відкритих голосувань.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead>
                    <tr>
                        <th>Кандидат</th>
                        <th>Рахунок</th>
                        <th>Блок. голосуванням</th>
                        <th>За</th>
                        <th>Проти</th>
                        <th>Треба «За»</th>
                        <th>Квартир+паркомісць</th>
                        <th>До</th>
                        <th>Відкрив</th>
                        <th>Дія</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for c in open %}
                        <tr>
                            <td>
                                {% if c.kind == 'question' %}❓{% else %}🚫{% endif %}
                                {{ c.label }}
                                {% if c.details %}<br><small class="text-muted">{{ c.details }}</small>{% endif %}
                            </td>
                            <td>{{ c.account_number ?? '—' }}</td>
                            <td>{% if c.blocks > 0 %}<span class="badge bg-warning text-dark">{{ c.blocks }}×</span>{% else %}—{% endif %}</td>
                            <td><b>{{ c.yes }}</b></td>
                            <td>{{ c.no }}</td>
                            {# A question crosses no line, so «треба N» would be a number that decides nothing. #}
                            <td>{{ c.kind == 'question' ? '—' : c.needed }}</td>
                            <td>{{ c.eligible }}</td>
                            <td>{{ c.deadline|date('d.m.Y') }}</td>
                            <td>{{ c.created_by ?? '—' }}</td>
                            <td>
                                <form method="post" action="{{ path('app_admin_block_vote_remind') }}" class="mb-1"
                                      onsubmit="return confirm('Надіслати нагадування всім, хто ще не проголосував?');">
                                    <input type="hidden" name="campaign_id" value="{{ c.id }}">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">📣 Нагадати тим, хто не голосував</button>
                                </form>
                                {#
                                    A resident's question is live but quiet until somebody
                                    accountable sends it — see BlockVoteService::broadcast().
                                #}
                                {% if not c.broadcast %}
                                    <form method="post" action="{{ path('app_admin_block_vote_broadcast') }}" class="mb-1"
                                          onsubmit="return confirm('Розіслати це питання всім мешканцям з правом голосу? Відкликати розсилку не можна.');">
                                        <input type="hidden" name="campaign_id" value="{{ c.id }}">
                                        <button type="submit" class="btn btn-sm btn-success">📣 Розіслати всім</button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('app_admin_block_vote_cancel') }}"
                                      onsubmit="return confirm('Скасувати це голосування?');">
                                    <input type="hidden" name="campaign_id" value="{{ c.id }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Скасувати</button>
                                </form>
                            </td>
                        </tr>
                        {% if c.ballots|length %}
                            <tr>
                                <td colspan="10" class="bg-light">
                                    {{ ballotBox.ballots(c.ballots, true) }}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {#
            A question put to the house. Deliberately advisory: nothing is enacted when it
            closes, the counts go in the archive and the ОСББ decides. A bot that could
            enact a house decision off a yes/no with no quorum would be worse than no bot.
        #}
        <div class="card mt-4 mb-3">
            <div class="card-header">❓ Поставити питання мешканцям</div>
            <div class="card-body">
                <p class="small text-muted">
                    Так / Ні, {{ vote_days }} днів, один голос від рахунку, і він остаточний
                    — у панелі видно, хто як проголосував. Нічого не блокує і
                    нічого не вмикає автоматично — це опитування, рішення ухвалює ОСББ, а
                    результат лишається в архіві голосувань, який бачать усі мешканці.
                    Питання на три варіанти — це питання на збори, а не сюди.
                </p>
                <form method="post" action="{{ path('app_admin_block_vote_question') }}"
                      onsubmit="return confirm('Розіслати це питання всім мешканцям з правом голосу?');">
                    <div class="form-group mb-2">
                        <input type="text" name="question" class="form-control" required minlength="10"
                               placeholder="Наприклад: Чи встановлюємо шлагбаум на в'їзді?">
                    </div>
                    <div class="form-group mb-2">
                        <textarea name="details" class="form-control" rows="2"
                                  placeholder="Необов'язково: чому питаємо, скільки коштує, що буде далі"></textarea>
                    </div>
                    <button class="btn btn-primary">Поставити питання</button>
                </form>
            </div>
        </div>

        <h5 class="mt-4">Завершені голосування</h5>
        {% if recent is empty %}
            <p class="text-muted">Поки що немає.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead>
                    <tr>
                        <th>Кандидат</th>
                        <th>Рахунок</th>
                        <th>Блок. голосуванням</th>
                        <th>Результат</th>
                        <th>За</th>
                        <th>Проти</th>
                        <th>Треба було «За»</th>
                        <th>Завершено</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for c in recent %}
                        <tr>
                            <td>{% if c.kind == 'question' %}❓{% else %}🚫{% endif %} {{ c.label }}</td>
                            <td>{{ c.account_number ?? '—' }}</td>
                            <td>{% if c.blocks > 0 %}<span class="badge bg-warning text-dark">{{ c.blocks }}×</span>{% else %}—{% endif %}</td>
                            <td>
                                {# A question is recorded, not judged — the result is the counts beside it. #}
                                {% if c.status == 'closed' %}<span class="badge bg-info text-dark">Опитано</span>
                                {% elseif c.status == 'passed' %}<span class="badge badge-danger">Заблоковано</span>
                                {% elseif c.status == 'failed' %}<span class="badge badge-success">Не пройшло</span>
                                {% else %}<span class="badge badge-secondary">Скасовано</span>{% endif %}
                            </td>
                            <td>{{ c.yes ?? 0 }}</td>
                            <td>{{ c.no ?? 0 }}</td>
                            <td>{{ c.kind == 'question' ? '—' : c.needed }}</td>
                            <td>{{ c.closed_at ? c.closed_at|date('d.m.Y H:i') : '—' }}</td>
                        </tr>
                        {% if c.ballots|length %}
                            <tr>
                                <td colspan="8" class="bg-light">
                                    {{ ballotBox.ballots(c.ballots, false) }}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <a href="{{ path('app_admin') }}" class="btn btn-link">← До панелі</a>
    </div>
{% endblock %}
