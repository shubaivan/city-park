{% extends 'base.html.twig' %}

{% block title %}SMS · ОСББ City Park{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if preview is not null %}
        {# select2's own stylesheet, split out of the entry at the end of the page. #}
        {{ encore_entry_link_tags('index/js/sms_debt.min') }}
    {% endif %}
{% endblock %}

{#
    The SMS journal: one row per attempt, sent or not. Failures stay on the page on
    purpose — «чому їй не прийшло» is answered by the row that says why.
#}
{% block body %}
    {{ parent() }}

    {# While a run goes, the card is greyed out, so a reload loses nothing and the count moves by itself. #}
    {% if run|default(null) and run.run.running %}
        <meta http-equiv="refresh" content="15">
    {% endif %}

    {# On a phone the two buttons are the whole width: a thumb, not a cursor. #}
    <style>
        @media (max-width: 575.98px) { .btn-block-xs { display: block; width: 100%; } }
    </style>

    {% set purposes = {'debt': '💸 борг', 'announcement': '📢 оголошення', 'test': '🧪 тест'} %}

    <div class="container-fluid py-3" style="max-width: 1000px;">
        <p class="mb-2"><a href="{{ path('app_admin') }}">← На головну адмінки</a></p>

        <h4 class="mb-1">✉️ SMS</h4>
        <p class="text-muted small mb-3">
            Кому, коли і що бот надіслав через TurboSMS. Невдалі спроби теж тут — з причиною.
        </p>

        <div class="card mb-3">
            <div class="card-body py-2 px-3 small">
                <div class="mb-1" style="font-size: 1rem;">
                    💳 Баланс TurboSMS:
                    {% if balance is null %}
                        <b class="text-muted">невідомий</b> <span class="text-muted small">(сервіс не відповів або не налаштований)</span>
                    {% else %}
                        <b>{{ balance|number_format(2, '.', ' ') }} грн</b>
                        <span class="text-muted">≈ {{ (balance / price)|round(0, 'floor')|number_format(0, '.', ' ') }} SMS</span>
                    {% endif %}
                </div>
                За цей місяць: надіслано <b>{{ month.sent }}</b>
                ({{ month.parts }} SMS до оплати × {{ price|number_format(2, '.', ' ') }} грн
                = <b>{{ (month.parts * price)|number_format(2, '.', ' ') }} грн</b>){% if month.failed > 0 %},
                не надіслано <b>{{ month.failed }}</b>{% endif %}.
                {% if month.unknown|default(0) > 0 %}
                    Невідомо, чи пішло: <b>{{ month.unknown }}</b> (якщо пішли, ще {{ (month.unknownParts * price)|number_format(2, '.', ' ') }} грн; точно видно в кабінеті TurboSMS).
                {% endif %}
                <div class="text-muted">Ціна TurboSMS — {{ price|number_format(2, '.', ' ') }} грн за одну SMS.</div>
                {#
                    How to put money on it, so the ОСББ does not need Иван for that (07.10.2026).
                    Copied from TurboSMS's own top-up page: a terminal takes the account ID with
                    no login; every other way goes through the cabinet, which is Иван's.
                #}
                <details class="mt-2" {{ balance is not null and balance < 20 ? 'open' }}>
                    <summary>💳 Як поповнити рахунок TurboSMS</summary>
                    <ol class="pl-3 mb-1 mt-1">
                        <li class="mb-1">
                            <b>Самостійно, без входу в кабінет</b> — термінал або застосунок
                            <b>EasyPay</b> (комісія 1,5%) чи <b>City24</b> (3%): у пошуку знайдіть
                            «TurboSMS», введіть ID <b style="user-select: all">{{ turbosms_id }}</b>, суму — і оплатіть.
                            Гроші зараховуються одразу.
                        </li>
                        <li class="mb-1">
                            <b>Безготівково з рахунку ОСББ</b> — тоді TurboSMS надає акт для бухгалтерії.
                            Рахунок на оплату формується в кабінеті turbosms.ua: напишіть Івану суму.
                        </li>
                        <li>
                            Карткою, через Приват24 або LiqPay (без комісії) — теж лише через кабінет, тобто через Івана.
                        </li>
                    </ol>
                    <div class="text-muted">Після поповнення оновіть цю сторінку — баланс угорі зміниться.</div>
                </details>
            </div>
        </div>

        {% if run|default(null) %}
            <div class="card mb-3 {{ run.run.running ? 'border-primary' : (run.run.stopped ? 'border-warning' : 'border-success') }}" id="sms-run">
                <div class="card-body py-2 px-3 small">
                    <div style="font-size: 1rem;">
                        📨 <b>Надіслано {{ run.sent }} з {{ run.total }}</b>{% if run.run.running %} <span class="text-muted">· йде</span>{% elseif run.run.stopped %} <span class="text-warning">· зупинено</span>{% else %} <span class="text-success">· завершено</span>{% endif %}
                    </div>
                    {% if run.sent > 0 %}
                        <div>
                            З надісланих: доставлено <b>{{ run.delivered|default(0) }}</b>{% if run.undelivered|default(0) > 0 %}, не доставлено <b>{{ run.undelivered }}</b>{% endif %}{% if run.awaiting|default(0) > 0 %}, чекаємо статус <b>{{ run.awaiting }}</b>{% endif %}{% if run.unanswered|default(0) > 0 %}, статус не отримано <b>{{ run.unanswered }}</b>{% endif %}.
                        </div>
                    {% endif %}
                    {% if run.failed > 0 %}Не надіслано: <b>{{ run.failed }}</b>. {% endif %}
                    {% if run.unknown > 0 %}Невідомо, чи пішло: <b>{{ run.unknown }}</b> (сьогодні повторно не підуть). {% endif %}
                    {% if run.sending > 0 %}Надсилається або без відповіді: <b>{{ run.sending }}</b>. {% endif %}
                    {% if run.queued > 0 %}{{ run.run.running ? 'У черзі' : 'Без рядка в журналі' }}: <b>{{ run.queued }}</b>. {% endif %}
                    {% if run.run.stopReason %}<div class="text-danger">{{ run.run.stopReason }}</div>{% endif %}
                    {% if run.checksStalled|default(false) %}<div class="alert alert-warning py-1 px-2 mt-1 mb-0">Статуси доставки не оновлюються: схоже, не працює воркер SMS. Напишіть Івану.</div>{% endif %}
                    {% if run.stalled %}<div class="alert alert-warning py-1 px-2 mt-1 mb-0">Черга не рухається понад 5 хвилин: схоже, не працює воркер. Напишіть Івану.</div>{% endif %}
                    <div class="text-muted">Хто саме і чому: журнал нижче.{% if run.run.running %} Сторінка оновлюється сама.{% endif %}</div>
                </div>
            </div>
        {% endif %}

        {% if preview is not null %}
            {#
                Людмила's button (07.10.2026), and since Иван's ask of 04.11.2026 the list behind
                it: every debtor above the threshold, ticked by hand, the sum beside the button
                following the ticks. Parts per row come from the server, so the arithmetic here
                is only ever SmsSender::parts() × the price; the server redoes it at each step.
                Nothing on this card spends anything: the form is a GET to the confirmation.
            #}
            <style>
                /* 13px is a mouse's checkbox: on a phone it is a thumb's target. */
                @media (max-width: 575.98px) {
                    #debt-sms-form input[type="checkbox"] { width: 22px; height: 22px; }
                }
                #debt-sms-bar {
                    position: sticky;
                    bottom: 0;
                    z-index: 2;
                    background: #fff;
                    border-top: 1px solid #dee2e6;
                    padding: .5rem 0 calc(.5rem + env(safe-area-inset-bottom));
                }
            </style>
            {% set selectable = preview.rows|filter(r => r.reason is null) %}
            {% set unreachable = preview.rows|filter(r => r.reason is not null) %}
            <div class="card mb-3 border-primary" id="debt-sms">
                <div class="card-body py-2 px-3">
                    <h6 class="mb-2">💸 SMS боржникам понад {{ min_debt|number_format(0, '.', ' ') }} грн</h6>

                    <p class="small mb-2">
                        Боржників: <b>{{ preview.debtors }}</b> · можна надіслати: <b>{{ selectable|length }}</b>{% if preview.skippedSummary %}
                        · не можна: {{ preview.skippedSummary }}{% endif %}.
                    </p>

                    {#
                        Людмила's first question: what if the number does not exist, and is money
                        taken? Nothing here promises a refund. TurboSMS bills every sent SMS unless
                        the account has a signed contract (turbosms.ua/ua/guide.html, 5.8;
                        /ua/price.html), and this app stores only the answer to the send, never a
                        delivery status. Above the list, because below it is 59 rows away on a phone.
                    #}
                    <div class="small mb-2" id="debt-sms-delivery-note">
                        <div>«✅ надіслано» означає, що TurboSMS прийняв SMS, а не що вона дійшла: це видно лише в його кабінеті.</div>
                        <div><b>Номера немає або телефон вимкнено:</b> гроші можуть списатись, бо оплачуються всі відправлені SMS. Повернення за недоставлені є лише за договором з TurboSMS.</div>
                        <div>Рядки з ⛔ у цьому списку не надсилаються і нічого не коштують.</div>
                    </div>

                    <form id="debt-sms-form" method="get"{% if preview.unavailable is null %} action="{{ path('app_admin_sms_debt_confirm') }}"{% endif %}
                          data-price="{{ price }}" data-balance="{{ preview.balance }}" data-available="{{ preview.unavailable is null ? '1' : '0' }}">
                        {#
                            Every debtor, not only those above the threshold (Иван, 04.11.2026). No
                            name on the select: what is picked becomes a row with a checkbox, so
                            there is one way into `ids[]` and nobody can be in it twice. The option
                            says who cannot be written to and why, and cannot be picked.
                        #}
                        {% set searchable = preview.searchable|default([]) %}
                        {% if searchable is not empty %}
                            <div class="form-group mb-2">
                                <label for="debt-sms-search" class="small mb-1">
                                    ➕ <b>Додати боржника</b>: усі боржники, {{ searchable|length }}, з номером {{ searchable|filter(r => r.reason is null)|length }}.
                                    Шукайте за будинком і квартирою («27 63») або номером телефону.
                                </label>
                                <select id="debt-sms-search" class="form-control form-control-sm" autocomplete="off" data-placeholder="Будинок, квартира…">
                                    <option value=""></option>
                                    {% for r in searchable %}
                                        {% set debt = r.account.debt|number_format(2, '.', ' ') %}
                                        <option value="{{ r.account.id }}"{{ r.reason is not null ? ' disabled' }}
                                                data-place="{{ r.account.placeLabel }}" data-debt="{{ debt }}" data-phone="{{ r.phone }}" data-parts="{{ r.parts }}"
                                                data-house="{{ r.account.houseNumber }}" data-unit="{{ r.account.apartmentNumber }}" data-kind="{{ r.account.unitType }}">{{ r.account.placeLabel }} · {{ debt }} грн · {{ r.reason is null ? r.phone : '⛔ ' ~ r.reason }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}

                        <div class="table-responsive">
                            <table class="table table-sm small mb-2">
                                <thead>
                                    <tr>
                                        <th style="width: 1%;">
                                            <input type="checkbox" id="debt-sms-all" autocomplete="off" aria-label="Вибрати всіх"{{ selectable is empty ? ' disabled' }}>
                                        </th>
                                        <th><label for="debt-sms-all" id="debt-sms-all-label" class="mb-0">Вибрати всіх ({{ selectable|length }})</label></th>
                                        <th class="text-right">Борг</th>
                                        <th>Номер</th>
                                    </tr>
                                </thead>
                                <tbody id="debt-sms-rows">
                                    {% for r in selectable %}
                                        <tr>
                                            <td><input type="checkbox" class="debt-sms-pick" autocomplete="off" id="debt-sms-{{ r.account.id }}" name="ids[]" value="{{ r.account.id }}" data-parts="{{ r.parts }}"></td>
                                            <td><label for="debt-sms-{{ r.account.id }}" class="mb-0">{{ r.account.placeLabel }}</label></td>
                                            <td class="text-right text-nowrap"><b>{{ r.account.debt|number_format(2, '.', ' ') }}</b></td>
                                            <td class="text-nowrap">{{ r.phone }}</td>
                                        </tr>
                                    {% endfor %}
                                    {% for r in unreachable %}
                                        <tr class="text-muted">
                                            <td><input type="checkbox" disabled aria-label="Не можна вибрати: {{ r.reason }}"></td>
                                            <td>{{ r.account.placeLabel }}</td>
                                            <td class="text-right text-nowrap">{{ r.account.debt|number_format(2, '.', ' ') }}</td>
                                            <td>{% if r.phone %}{{ r.phone }} · {% endif %}<span class="debt-sms-reason">⛔ {{ r.reason }}</span></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {#
                            The button is always on the card. Hiding it when the balance was short
                            read as «there is no button» (Иван and Людмила, 02.11.2026): it is greyed
                            out, with the reason right under it. It stays at the bottom of the screen
                            so the sum stays in sight while scrolling down a long list on a phone.
                        #}
                        <div id="debt-sms-bar">
                            <div class="d-flex flex-wrap align-items-center">
                                <button type="{{ preview.unavailable is null ? 'submit' : 'button' }}" id="debt-sms-send" class="btn btn-secondary btn-block-xs mr-sm-3" disabled>📨 Відправити СМС</button>
                                <span class="small">
                                    <b id="debt-sms-count">0</b> SMS · <b><span id="debt-sms-cost">0.00</span> грн</b>
                                    · на рахунку {{ preview.balance is null ? 'невідомо' : preview.balance|number_format(2, '.', ' ') ~ ' грн' }}{% if preview.balance is not null %}
                                    · залишиться <span id="debt-sms-left">{{ preview.balance|number_format(2, '.', ' ') }}</span> грн{% endif %}
                                </span>
                            </div>
                            {# Why the button is grey belongs beside the button: below the list it is 59 rows away on a phone. #}
                            <div id="debt-sms-short" class="alert alert-warning py-1 px-2 small mt-1 mb-0" hidden></div>
                            {% if preview.unavailable is not null %}
                                <div class="alert alert-warning py-1 px-2 small mt-1 mb-0">{{ preview.unavailable }}</div>
                            {% endif %}
                        </div>
                    </form>

                    <div class="small text-muted mt-2">
                        Спершу покажемо, кому і за скільки, — без підтвердження нічого не піде. Надсилаємо
                        у фоні, по одній, тому вкладку можна закрити. Перед кожною SMS перевіряємо борг: хто вже
                        сплатив, не отримає, а суму беремо ту, що на той момент.
                        Текст: «Буд.27 кв.63: борг 5430 грн. Просимо сплатити.» — одна SMS на адресу, на номер мешканця
                        з бота або записаний в «Очікуємо в боті». Той самий номер двічі за день не отримає.
                        Надіслані з'являться в журналі нижче — кому, коли і хто надіслав.
                    </div>
                </div>
            </div>

            <script>
                (function () {
                    var form = document.getElementById('debt-sms-form');
                    var all = document.getElementById('debt-sms-all');
                    var send = document.getElementById('debt-sms-send');
                    var short = document.getElementById('debt-sms-short');
                    var left = document.getElementById('debt-sms-left');
                    var allLabel = document.getElementById('debt-sms-all-label');
                    var price = parseFloat(form.dataset.price);
                    var balance = form.dataset.balance === '' ? null : parseFloat(form.dataset.balance);
                    var available = form.dataset.available === '1';
                    var money = function (n) {
                        return n.toFixed(2).replace(/\B(?=(\d{3})+\.)/g, ' ');
                    };

                    // Read anew each time: the search adds rows (assets/js/sms_debt.js).
                    function pickBoxes() {
                        return Array.prototype.slice.call(form.querySelectorAll('.debt-sms-pick'));
                    }

                    function refresh() {
                        var picks = pickBoxes();
                        var ticked = picks.filter(function (p) { return p.checked; });
                        var parts = ticked.reduce(function (sum, p) { return sum + parseInt(p.dataset.parts, 10); }, 0);
                        var cost = Math.round(parts * price * 100) / 100;
                        var isShort = balance !== null && balance < cost;

                        document.getElementById('debt-sms-count').textContent = parts;
                        document.getElementById('debt-sms-cost').textContent = money(cost);
                        if (left) {
                            left.textContent = money(Math.max(balance - cost, 0));
                        }

                        allLabel.textContent = 'Вибрати всіх (' + picks.length + ')';
                        all.disabled = picks.length === 0;
                        all.checked = picks.length > 0 && ticked.length === picks.length;
                        all.indeterminate = ticked.length > 0 && ticked.length < picks.length;

                        short.hidden = !isShort;
                        short.textContent = isShort
                            ? 'На рахунку ' + money(balance) + ' грн, а вибрано на ' + money(cost) + ' грн — бракує ' + money(cost - balance) + ' грн.'
                            : '';

                        var canSend = available && ticked.length > 0 && !isShort;
                        send.disabled = !canSend;
                        send.classList.toggle('btn-danger', canSend);
                        send.classList.toggle('btn-secondary', !canSend);
                    }

                    all.addEventListener('change', function () {
                        pickBoxes().forEach(function (p) { p.checked = all.checked; });
                        refresh();
                    });
                    form.addEventListener('change', function (event) {
                        if (event.target.classList.contains('debt-sms-pick')) {
                            refresh();
                        }
                    });
                    // Back from the confirmation: the browser restores the ticks after the script ran.
                    window.addEventListener('pageshow', refresh);
                    refresh();
                })();
            </script>
            {{ encore_entry_script_tags('index/js/sms_debt.min') }}
        {% endif %}

        {% if entries is empty %}
            <div class="alert alert-light py-2 px-3 small mb-0">Поки що жодної SMS.</div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small">
                        <thead>
                            <tr>
                                <th>Коли</th>
                                <th>Кому</th>
                                <th>Текст</th>
                                <th class="d-none d-md-table-cell">Хто</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for e in entries %}
                                <tr class="{{ e.failed ? 'table-warning' : '' }}">
                                    <td class="text-nowrap">{{ e.createdAt|date('d.m.Y H:i', 'Europe/Kyiv') }}</td>
                                    <td class="text-nowrap">
                                        <a href="tel:+{{ e.phone|trim('+') }}">{{ e.phone }}</a>
                                        {% set place = e.placeLabel ?: (e.account ? e.account.placeLabel : null) %}
                                        <div>{{ place ?: '—' }}</div>
                                        {% if e.debt is not null %}
                                            <div class="text-muted">
                                                {% if e.debt > 0 %}борг {{ e.debt|number_format(2, '.', ' ') }} грн{% else %}без боргу{% endif %}{% if e.debtAsOf %}
                                                <span title="дата файлу боргів, з якого взято суму">· станом на {{ e.debtAsOf|date('d.m') }}</span>{% endif %}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if e.status == 'sent' %}✅ надіслано
                                        {% elseif e.status == 'dry_run' %}👁 пробний запуск, не надсилалось
                                        {% elseif e.status == 'sending' %}⏳ надсилається або без відповіді, сьогодні повторно не піде
                                        {% elseif e.error and e.error starts with constant('App\\Service\\SmsSender::OUTCOME_UNKNOWN') %}❓ <b>{{ e.error }}</b>, сьогодні повторно не піде
                                        {% else %}⛔ не надіслано{% if e.error %}: <b>{{ e.error }}</b>{% endif %}
                                        {% endif %}
                                        <span class="text-muted">· {{ purposes[e.purpose] ?? e.purpose }}{% if e.parts > 1 %} · {{ e.parts }} SMS{% endif %}{% if e.status == 'sent' %} · {{ (e.parts * price)|number_format(2, '.', ' ') }} грн{% endif %}</span>
                                        {% if e.status == 'sent' and e.deliveryLabel %}<div>{{ e.deliveryLabel }}</div>{% endif %}
                                        <div style="white-space: pre-wrap">{{ e.text }}</div>
                                        <div class="d-md-none text-muted">{{ e.sentBy ?? '—' }}</div>
                                    </td>
                                    <td class="d-none d-md-table-cell text-muted">{{ e.sentBy ?? '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <p class="small text-muted mt-2 mb-0">
                Показано останні {{ entries|length }} записів{% if entries|length == shown %} (більше не вміщається на сторінку){% endif %}.
                Час київський.
            </p>
        {% endif %}
    </div>
{% endblock %}
