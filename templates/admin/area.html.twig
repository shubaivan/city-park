{% extends 'base.html.twig' %}

{% block title %}Реєстр площ · ОСББ City Park{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container mt-4">
        <h3>📐 Площі квартир — реєстр</h3>

        <div class="alert alert-warning" id="area-locked">
            <p class="mb-1"><b>🔒 Реєстр площ зафіксовано.</b> Будинок не змінюється, реєстр уже завантажено, тож через сайт його більше не завантажують — ні з якого логіну.</p>
            <p class="mb-0">Якщо площа змінилась або з'явився новий об'єкт — напишіть Івану, він оновить реєстр.</p>
        </div>

        <div class="alert alert-light">
            📊 У базі зараз <b>{{ with_area }}</b> з <b>{{ total }}</b> акаунтів мають заповнену площу.
        </div>

        {% if success is defined %}
            <div class="alert alert-success">{{ success }}</div>
        {% endif %}
        {% if error is defined %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}
        {% if not_found is defined and not_found|length > 0 %}
            <details>
                <summary>Особові рахунки з файлу, яких немає в базі ({{ not_found|length }})</summary>
                <ul>
                    {% for acc in not_found %}<li>{{ acc }}</li>{% endfor %}
                </ul>
            </details>
        {% endif %}

        <a href="{{ path('app_admin') }}" class="btn btn-link px-0 mt-2">← Назад</a>

        <p class="text-muted mt-3"><small>Площу окремого акаунта можна виправити вручну у <a href="{{ path('app_admin_users') }}">/admin/users</a> через кнопку «Редагувати».</small></p>
    </div>

        {# Same archive as /admin/debt: the registry these thresholds are computed from
           was overwritten in place and the file itself kept nowhere. #}
        <div class="mt-4">
            <h5>📁 Архів завантажень реєстру</h5>
            {% if archive is not defined or archive|length == 0 %}
                <p class="text-muted"><small>Поки що порожньо.</small></p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm table-striped" style="max-width:640px">
                        <thead>
                        <tr><th>Коли</th><th>Хто</th><th>Розмір</th><th></th></tr>
                        </thead>
                        <tbody>
                        {% for item in archive %}
                            <tr>
                                <td>{{ item.uploaded_at|date('d.m.Y H:i') }}</td>
                                <td>{{ item.actor }}</td>
                                <td>{{ (item.size / 1024)|round }} КБ</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="{{ path('app_admin_import_archive_download', {kind: 'area', name: item.name}) }}">
                                        ⬇️ Завантажити
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

{% endblock %}
