{% extends 'base.html.twig' %}

{#
    One place that knows what each kind of link is and where it goes.

    It used to be an if/else ending in a bare `else`, twice — so a kind nobody had added
    (votes, the debtors' post) was drawn as «🔧 заявка» and linked to the rental register.
    That is not a cosmetic slip: the row said 56 people had opened a complaint that does
    not exist, and the link took every one of them somewhere unrelated. A kind this file
    does not know now says so.
#}
{% macro kindIcon(kind) %}
    {%- if kind == 'service' -%}🛠
    {%- elseif kind == 'rental' -%}🔑
    {%- elseif kind == 'complaint' -%}🔧
    {%- elseif kind == 'vote' -%}🗳
    {%- elseif kind == 'debt' -%}💸
    {%- else -%}↗️
    {%- endif -%}
{% endmacro %}

{% macro kindWord(kind) %}
    {%- if kind == 'service' -%}послуга
    {%- elseif kind == 'rental' -%}оренда
    {%- elseif kind == 'complaint' -%}заявка
    {%- elseif kind == 'vote' -%}голосування
    {%- elseif kind == 'debt' -%}борги
    {%- else -%}посилання
    {%- endif -%}
{% endmacro %}

{#
    The complaints register is open to both roles; the rest of the panel is the
    accountant's alone. A link that renders and then answers 403 is reported as «панель не
    працює», so `ROLE_COMPLAINTS` gets plain text everywhere else.
#}
{% macro targetHref(kind, id) %}
    {%- if kind == 'complaint' -%}{{ path('app_admin_complaints') }}#complaint-{{ id }}
    {%- elseif not is_granted('ROLE_ADMIN') -%}
    {%- elseif kind == 'service' -%}{{ path('app_admin_services') }}#offer-{{ id }}
    {%- elseif kind == 'rental' -%}{{ path('app_admin_rentals') }}#listing-{{ id }}
    {%- elseif kind == 'vote' -%}{{ path('app_admin_block_votes') }}
    {%- elseif kind == 'debt' -%}{{ path('app_admin_debt') }}
    {%- endif -%}
{% endmacro %}

{% import _self as link %}

{% block title %}Переходи з чату · ОСББ City Park{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container-fluid mt-3">
        <h3>↗️ Переходи з чату мешканців</h3>
        <p class="text-muted">
            Хто натиснув «Відкрити в боті» під постом у чаті — і що саме відкрив.
            Telegram не каже, хто <i>прочитав</i> повідомлення бота: список прочитань
            показується лише тому, хто його надіслав, а надсилає їх бот. Тож натискання —
            єдиний доступний сигнал, і чесніший: «прочитано» означає «прогорнув повз»,
            а натискання — «зацікавився».
        </p>
        <p class="text-muted small">
            Записуються <b>тільки переходи за посиланням із чату</b>. Звичайний перегляд
            карток усередині бота не пишеться — питання тут «чи спрацював пост», а не
            «що читає цей мешканець».
        </p>

        {#
            Every board, including the ones nobody has opened.

            The table under this one lists posts that got a click, so a board being ignored
            has no row at all — and «немає рядка» reads as «немає такого», not as nought.
            Whether the chat post works for that board is the one question this page exists
            to answer, so the zero has to be printed.
        #}
        <h5 class="mt-4">За розділами</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead>
                <tr>
                    <th>Розділ</th>
                    <th>Постів із переходами</th>
                    <th>Натискань</th>
                    <th>Людей</th>
                </tr>
                </thead>
                <tbody>
                {% for row in by_kind %}
                    <tr{% if row.clicks == 0 %} class="text-muted"{% endif %}>
                        <td>{{ link.kindIcon(row.kind) }} {{ row.word }}</td>
                        <td>{{ row.posts }}</td>
                        <td>
                            {% if row.clicks > 0 %}
                                <span class="badge badge-primary">{{ row.clicks }}</span>
                            {% else %}0{% endif %}
                        </td>
                        <td>{{ row.people }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <h5 class="mt-4">За оголошеннями</h5>
        {% if summary|length == 0 %}
            <div class="alert alert-secondary">Переходів ще не було.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                    <tr>
                        <th>Що</th>
                        <th>Натискань</th>
                        <th>Людей</th>
                        <th>Востаннє</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in summary %}
                        {% set target = titles[row.kind][row.target_id] ?? null %}
                        {#
                            Straight to the row, not to the top of a page somebody then has
                            to scan: this table is read to answer «а що це було», and the
                            answer is one click away or it is not an answer.
                        #}
                        {% set href = link.targetHref(row.kind, row.target_id)|trim %}
                        <tr>
                            <td>
                                {{ link.kindIcon(row.kind) }}
                                {% if target %}
                                    {% if href %}<a href="{{ href }}">{% endif %}
                                    {% if row.kind == 'service' %}
                                        <b>{{ target.title }}</b>
                                    {% elseif row.kind == 'rental' %}
                                        <b>{{ target.account.unitLabel }}</b>
                                        <small class="text-muted">{{ target.priceLabel }}</small>
                                    {% elseif row.kind == 'complaint' %}
                                        <b>№{{ target.id }}</b>
                                        <small class="text-muted">{{ target.text|slice(0, 70) }}</small>
                                    {% elseif row.kind == 'vote' %}
                                        <b>{{ target.question ?? 'Блокування' }}</b>
                                    {% elseif row.kind == 'debt' %}
                                        {# The link always opens the current board; the snapshot says which post it was. #}
                                        <b>Оголошення про борги</b>
                                        <small class="text-muted">{{ target.takenAt|date('d.m.Y') }}</small>
                                    {% else %}
                                        <b>#{{ row.target_id }}</b>
                                    {% endif %}
                                    {% if href %}</a>{% endif %}
                                {% else %}
                                    {# Deleted since — the click is still a fact about the post. #}
                                    <span class="text-muted">{{ link.kindWord(row.kind) }} #{{ row.target_id }} (видалено)</span>
                                {% endif %}
                            </td>
                            <td><span class="badge badge-primary">{{ row.clicks }}</span></td>
                            <td>{{ row.people }}</td>
                            <td><small>{{ row.last_at|date('d.m.Y H:i') }}</small></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <h5 class="mt-4">Останні переходи</h5>
        {% if recent|length == 0 %}
            <div class="alert alert-secondary">Порожньо.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                    <tr>
                        <th>Коли</th>
                        <th>Хто</th>
                        <th>Квартира</th>
                        <th>Що відкрив</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for click in recent %}
                        <tr>
                            <td><small>{{ click.createdAt|date('d.m.Y H:i') }}</small></td>
                            <td>
                                {% if click.user %}
                                    {{ click.user.fullName ?? (click.user.firstName ~ ' ' ~ click.user.lastName)|trim }}
                                    {#
                                        The @username opens the chat with that person.

                                        Reading this page ends in «треба щось у них спитати»
                                        often enough that copying a nickname by hand and
                                        pasting it into Telegram search was the actual next
                                        step. `t.me/<username>` does it in a tap, on the
                                        phone this is read on as much as on a desktop.
                                    #}
                                    {% if click.user.username %}
                                        <br>
                                        <small>
                                            <a href="https://t.me/{{ click.user.username }}"
                                               target="_blank" rel="noopener">@{{ click.user.username }}</a>
                                        </small>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if click.user and click.user.account %}
                                    <a href="{{ path('app_admin_resident', {id: click.user.id}) }}">
                                        {{ click.user.account.placeLabel }}
                                    </a>
                                {% else %}
                                    <span class="text-muted">⏳ не прив'язаний</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set clickHref = link.targetHref(click.kind, click.targetId)|trim %}
                                {% if clickHref %}<a href="{{ clickHref }}">{% endif %}
                                    {{ link.kindIcon(click.kind) }} {{ link.kindWord(click.kind) }} #{{ click.targetId }}
                                {% if clickHref %}</a>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
