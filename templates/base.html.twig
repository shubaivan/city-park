<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    {#
        Without this, every admin page renders at a 980px desktop width on a phone and is
        zoomed out to unreadable — Bootstrap's grid, the DataTables responsive plugin and
        every `col-sm-*` in here are all no-ops until the viewport is declared. The two
        standalone upload pages had it from the start; the panel itself never did, and it
        is read on a phone (searching a resident, moving a complaint) as often as not.
    #}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {#
            The panel is worked from a phone — searching a resident, moving a complaint —
            and iOS zooms the whole page in whenever a focused field is smaller than 16px.
            Bootstrap's `form-control-sm`, which most of this admin uses, is 14px: every
            tap on a filter box left the page zoomed and scrolled sideways. Small screens
            only; the desktop table keeps its compact controls.
        #}
        <style>
            @media (max-width: 576px) {
                input, select, textarea { font-size: 16px !important; max-width: 100%; }
            }
        </style>
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('admin.jpg') }}">
    {% endblock %}
</head>
<body>
{% block body %}
    {#
        The navigation bar, rebuilt 04.09.2026.

        Logging out used to mean finding a hamburger button, expanding a dark panel that
        greeted you in English, and clicking a link with a three-sizes-too-big icon. On a
        phone that is three taps to leave a panel that holds every resident's phone number
        and debt — and the page you were on gave no clue which section you were even in.

        Now: the brand goes home, the sections are one tap away, and «Вийти» is always
        visible with the login next to it. The active section is marked, because the pages
        look alike and «де я?» is a question a nav bar should answer without being asked.
    #}
    <nav class="navbar navbar-expand navbar-dark bg-dark shadow-sm py-1 px-2 px-sm-3">
        <a href="{{ is_granted('IS_AUTHENTICATED_REMEMBERED') ? path('app_admin') : path('app_login') }}"
           class="navbar-brand mr-2" title="ОСББ City Park">🏢</a>

        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
            {# Null outside a request — a template rendered from a command or a test. #}
            {% set section = app.request ? app.request.attributes.get('_route') : '' %}
            <ul class="navbar-nav mr-auto flex-row" style="gap:.15rem">
                <li class="nav-item">
                    <a class="nav-link px-2 {{ section starts with 'app_admin_resident' or section == 'app_admin_users' ? 'active font-weight-bold' }}"
                       href="{{ path('app_admin_users') }}">👤 <span class="d-none d-sm-inline">Люди</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 {{ section starts with 'app_admin_objects' ? 'active font-weight-bold' }}"
                       href="{{ path('app_admin_objects') }}">🏢 <span class="d-none d-sm-inline">Об'єкти</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 {{ section starts with 'app_admin_complaint' ? 'active font-weight-bold' }}"
                       href="{{ path('app_admin_complaints') }}">🔧 <span class="d-none d-sm-inline">Заявки</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 {{ section starts with 'app_admin_debt' ? 'active font-weight-bold' }}"
                       href="{{ path('app_admin_debt') }}">💰 <span class="d-none d-sm-inline">Борги</span></a>
                </li>
            </ul>

            <span class="navbar-text text-white-50 small mr-2 d-none d-md-inline">{{ app.user.userIdentifier }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-light">Вийти</a>
        {% else %}
            <span class="mr-auto"></span>
            <a href="{{ path('app_login') }}" class="btn btn-sm btn-outline-light">Увійти</a>
        {% endif %}
    </nav>

    {#
        One line, in the panel's own language. It used to be a full-width block with the
        flash key as an English heading — «Notice» over «Роль оновлено» — which took a
        quarter of the screen on a phone to say nothing.
    #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set class = label == 'error' ? 'alert-danger' : (label == 'warning' ? 'alert-warning' : 'alert-success') %}
            {% set icon = label == 'error' ? '⚠️' : (label == 'warning' ? '❗' : '✅') %}

            <div class="alert {{ class }} py-2 px-3 mb-2 mx-2 mx-sm-3 mt-2" role="alert">
                {{ icon }} {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}

    {#    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>#}
    {#    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>#}
    <script src="/bundles/fosjsrouting/js/router.min.js"></script>
    <script src="/js/fos_js_routes.js"></script>

{% endblock %}
</body>
</html>
