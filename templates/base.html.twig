<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    {#
        Without this, every admin page renders at a 980px desktop width on a phone and is
        zoomed out to unreadable — Bootstrap's grid, the DataTables responsive plugin and
        every `col-sm-*` in here are all no-ops until the viewport is declared. The two
        standalone upload pages had it from the start; the panel itself never did, and it
        is read on a phone (searching a resident, moving a complaint) as often as not.
    #}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {#
            The panel is worked from a phone — searching a resident, moving a complaint —
            and iOS zooms the whole page in whenever a focused field is smaller than 16px.
            Bootstrap's `form-control-sm`, which most of this admin uses, is 14px: every
            tap on a filter box left the page zoomed and scrolled sideways. Small screens
            only; the desktop table keeps its compact controls.
        #}
        <style>
            @media (max-width: 576px) {
                input, select, textarea { font-size: 16px !important; max-width: 100%; }
            }
        </style>
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('admin.jpg') }}">
    {% endblock %}
</head>
<body>
{% block body %}
    <header>
        <div class="collapse bg-dark" id="navbarHeader">
            <div class="container">
                <div class="row">
                    <div class="col-sm-8 col-md-7 py-4">
                        <h4 class="text-white">You are</h4>
                        <p class="text-muted">
                            Hello, {{ app.user.userIdentifier }}
                        </p>
                    </div>
                    <div class="col-sm-4 offset-md-1 py-4">
                        {#<h4 class="text-white">Navigation</h4>#}
                        <ul class="list-unstyled">
                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                <li>
                                    <a href="{{ path('app_logout') }}" class="text-white row align-items-center">
                                        Logout <i class="fas fa-sign-out-alt fa-3x"></i>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="navbar navbar-dark bg-dark shadow-sm">
            <div class="container d-flex justify-content-between">
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED')%}
                    <a href="{{ path('app_admin') }}" class="navbar-brand d-flex align-items-center">
                        <i class="fas fa-home"></i>
                    </a>
                {% endif %}

                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    You are logged.
                {% else %}
                    <a href="{{ path('app_login') }}" class="float-lg-left">
                        Login <i class="fas fa-door-open"></i>
                    </a>
                {% endif %}

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarHeader"
                        aria-controls="navbarHeader" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
    </header>

    {#
        One line, in the panel's own language. It used to be a full-width block with the
        flash key as an English heading — «Notice» over «Роль оновлено» — which took a
        quarter of the screen on a phone to say nothing.
    #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set class = label == 'error' ? 'alert-danger' : (label == 'warning' ? 'alert-warning' : 'alert-success') %}
            {% set icon = label == 'error' ? '⚠️' : (label == 'warning' ? '❗' : '✅') %}

            <div class="alert {{ class }} py-2 px-3 mb-2 mx-2 mx-sm-3 mt-2" role="alert">
                {{ icon }} {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="alert alert-danger" role="alert" style="display: none">
        <h4 class="alert-heading">Error</h4>
        <p class="mb-0"><i class="fa fa-exclamation-circle"></i>Warning</p>
    </div>

    <div class="alert alert-success" role="alert" style="display: none">
        <h4 class="alert-heading">Successul!</h4>
        <p class="mb-0"><i class="fab fa-angellist"></i>Successul</p>
    </div>
{% endblock %}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}

    {#    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>#}
    {#    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>#}
    <script src="/bundles/fosjsrouting/js/router.min.js"></script>
    <script src="/js/fos_js_routes.js"></script>

{% endblock %}
</body>
</html>
