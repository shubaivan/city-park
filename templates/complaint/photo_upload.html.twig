{#
    Standalone page — deliberately not extending base.html.twig.

    It is opened inside Telegram's in-app browser on a phone, by a resident reporting a
    broken lift. Pulling in the Encore bundle would mean this page breaks whenever assets
    aren't rebuilt, for a form that is one file input and a list of thumbnails.

    A near-twin of rental/photo_upload.html.twig. Kept separate rather than shared: the two
    differ in every string a resident reads, and a single template threaded with "is this a
    listing or a complaint?" conditionals would be harder to change than two plain files.
#}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Фото до заявки №{{ complaint.id }}</title>
    {# Present only when the page runs as a Telegram Web App; the script is a no-op elsewhere. #}
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            margin: 0; padding: 20px 16px 40px;
            font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f5f6f8; color: #1c1e21;
        }
        @media (prefers-color-scheme: dark) {
            body { background: #17212b; color: #e9edf1; }
            .card { background: #202b36 !important; }
            .hint { color: #8b9aa8 !important; }
        }
        .wrap { max-width: 520px; margin: 0 auto; }
        h1 { font-size: 20px; margin: 0 0 4px; }
        .hint { color: #65676b; font-size: 14px; margin: 0 0 20px; }
        .card { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 16px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
        .thumb { position: relative; aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; background: #dfe3e8; }
        .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .thumb button {
            position: absolute; top: 6px; right: 6px; border: 0; cursor: pointer;
            width: 30px; height: 30px; border-radius: 50%;
            background: rgba(0,0,0,.6); color: #fff; font-size: 17px; line-height: 30px; padding: 0;
        }
        label.add {
            display: block; text-align: center; padding: 16px; border-radius: 10px;
            background: #2f81f7; color: #fff; font-weight: 600; cursor: pointer;
        }
        label.add.off { background: #b9bfc7; pointer-events: none; }
        button.done-btn {
            display: block; width: 100%; margin-top: 12px; padding: 16px; border: 0;
            border-radius: 10px; background: #1a7f37; color: #fff; font: inherit;
            font-weight: 600; cursor: pointer;
        }
        button.done-btn[disabled] { opacity: .6; cursor: default; }
        a.back { display: block; margin-top: 12px; text-align: center; color: #2f81f7; }
        input[type=file] { display: none; }
        .msg { margin-top: 12px; font-size: 14px; min-height: 20px; }
        .msg.err { color: #d63a2f; }
        .msg.busy { color: #d63a2f; font-weight: 600; }
        .msg.busy::before {
            content: ''; display: inline-block; vertical-align: -2px;
            width: 14px; height: 14px; margin-right: 8px; border-radius: 50%;
            border: 2px solid #d63a2f; border-top-color: transparent;
            animation: spin .8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .msg.ok { color: #1a7f37; }
        .done { margin-top: 20px; text-align: center; font-size: 14px; color: #65676b; }
    </style>
</head>
<body>
<div class="wrap">
    <h1>📷 Фото до заявки</h1>
    <p class="hint">
        Заявка №{{ complaint.id }} · {{ complaint.text|length > 90 ? complaint.text|slice(0, 89) ~ '…' : complaint.text }}<br>
        Додайте до {{ max }} фото — так голові ОСББ одразу видно, про що йдеться.
    </p>

    <div class="card">
        <div class="grid" id="grid">
            {% for path in complaint.photos %}
                <div class="thumb" data-path="{{ path }}">
                    <img src="{{ path }}" alt="">
                    <button type="button" title="Видалити">×</button>
                </div>
            {% endfor %}
        </div>

        <div style="margin-top:14px">
            <label class="add" id="addLabel" for="file">Вибрати фото</label>
            <input type="file" id="file" accept="image/*" multiple>
        </div>

        <div class="msg" id="msg"></div>

        <button type="button" class="done-btn" id="done">✅ Готово, повернутися в бот</button>
    </div>

    <p class="done">Фото додаються до заявки одразу — окремо зберігати нічого не треба.</p>
</div>

<script>
(function () {
    var MAX = {{ max }};
    var EDGE = 1600;
    var uploadUrl = {{ path('complaint_photo_upload', {token: token})|json_encode|raw }};
    var deleteUrl = {{ path('complaint_photo_delete', {token: token})|json_encode|raw }};
    var doneUrl = {{ path('complaint_photo_done', {token: token})|json_encode|raw }};

    // Present only when Telegram opened this page as a Web App (an inline web_app button).
    // Opened as an ordinary link — copied to a desktop browser, say — it is undefined and
    // the page degrades to a link back to the bot.
    var tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
    if (tg) { tg.ready(); tg.expand(); }

    var grid = document.getElementById('grid');
    var input = document.getElementById('file');
    var label = document.getElementById('addLabel');
    var msg = document.getElementById('msg');

    function say(text, cls) { msg.textContent = text || ''; msg.className = 'msg ' + (cls || ''); }

    var doneBtn = document.getElementById('done');

    /**
     * While a photo is going up, nothing else may be tapped.
     *
     * On a phone an upload is seconds of nothing happening, and the first instinct is to
     * press "Готово" — which closes the Web App and loses the picture mid-flight. So the
     * button is hidden outright rather than greyed out, and the status line spins in red
     * so it reads as "wait", not as decoration.
     */
    function busy(on) {
        doneBtn.style.display = on ? 'none' : '';
        label.classList.toggle('off', on || count() >= MAX);
    }
    function count() { return grid.querySelectorAll('.thumb').length; }

    function refresh() {
        var full = count() >= MAX;
        label.classList.toggle('off', full);
        label.textContent = full ? 'Більше ' + MAX + ' фото не можна' : 'Вибрати фото';
    }

    /*
     * Downscale in the browser before sending.
     *
     * php.ini on the server allows 2 MB per upload and a phone photo is 3-6 MB, so
     * without this every upload would be rejected. Re-encoding here also means we never
     * ship the original EXIF (GPS included) anywhere. The server re-encodes again as a
     * backstop — this is a convenience, not the security boundary.
     */
    function shrink(file) {
        return new Promise(function (resolve) {
            var url = URL.createObjectURL(file);
            var img = new Image();

            img.onload = function () {
                URL.revokeObjectURL(url);

                var scale = Math.min(1, EDGE / Math.max(img.width, img.height));
                var canvas = document.createElement('canvas');
                canvas.width = Math.round(img.width * scale);
                canvas.height = Math.round(img.height * scale);
                canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);

                canvas.toBlob(function (blob) {
                    resolve(blob || file);
                }, 'image/jpeg', 0.82);
            };

            // A format the canvas cannot read (HEIC on some Androids) still gets a try
            // server-side rather than a silent failure here.
            img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
            img.src = url;
        });
    }

    function addThumb(path) {
        var div = document.createElement('div');
        div.className = 'thumb';
        div.dataset.path = path;
        div.innerHTML = '<img alt=""><button type="button" title="Видалити">×</button>';
        div.querySelector('img').src = path;
        grid.appendChild(div);
        refresh();
    }

    grid.addEventListener('click', function (e) {
        var btn = e.target.closest('button');
        if (!btn) return;

        var thumb = btn.closest('.thumb');
        var body = new FormData();
        body.append('path', thumb.dataset.path);

        say('Видаляємо…');
        fetch(deleteUrl, {method: 'POST', body: body})
            .then(function (r) { return r.json().then(function (j) { return {ok: r.ok, j: j}; }); })
            .then(function (res) {
                if (!res.ok) { say(res.j.error || 'Не вдалося видалити.', 'err'); return; }
                thumb.remove();
                refresh();
                say('Видалено.', 'ok');
            })
            .catch(function () { say('Немає зв\'язку.', 'err'); });
    });

    input.addEventListener('change', function () {
        var files = Array.prototype.slice.call(input.files, 0, MAX - count());
        input.value = '';
        if (!files.length) return;

        busy(true);
        say('Завантажуємо фото… не закривайте сторінку', 'busy');

        // Sequential on purpose: the server counts photos per request, and a phone on
        // mobile data handles one upload at a time better than three at once.
        files.reduce(function (chain, file) {
            return chain.then(function () {
                return shrink(file).then(function (blob) {
                    var body = new FormData();
                    body.append('photo', blob, 'photo.jpg');

                    return fetch(uploadUrl, {method: 'POST', body: body})
                        .then(function (r) { return r.json().then(function (j) { return {ok: r.ok, j: j}; }); })
                        .then(function (res) {
                            if (!res.ok) { say(res.j.error || 'Не вдалося завантажити.', 'err'); return; }
                            addThumb(res.j.path);
                            say('Фото додано ✅', 'ok');
                        });
                });
            });
        }, Promise.resolve())
            // busy(false) on BOTH paths: it un-hides the "Готово" button, and a chain that
            // only restores it on success leaves the page with no way out the moment one
            // upload fails.
            .then(function () { busy(false); })
            .catch(function () { busy(false); say('Немає зв\'язку.', 'err'); });
    });

    doneBtn.addEventListener('click', function () {
        var btn = this;
        btn.disabled = true;
        say('Зберігаємо…', 'busy');

        fetch(doneUrl, {method: 'POST'})
            .then(function (r) { return r.ok; })
            .catch(function () { return false; })
            .then(function (ok) {
                if (!ok) { btn.disabled = false; say('Не вдалося. Спробуйте ще раз.', 'err'); return; }

                if (tg) {
                    // Closes the Web App and drops the resident back into the chat, where
                    // the bot has just posted the complaint with its new photo — otherwise
                    // they land on the "відкрийте сторінку" message that sent them here and
                    // it reads as if nothing happened.
                    tg.close();
                    return;
                }

                // Outside Telegram there is nothing to close, and the bot's @username is
                // not configured anywhere — just say it worked and let them switch back.
                say('Готово ✅ Фото додано — поверніться в бот.', 'ok');
                btn.remove();
            });
    });

    refresh();
})();
</script>
</body>
</html>
