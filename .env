# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=8bd712fc634a269a8caa4d9134d794c9
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# city park bot token
TELEGRAM_TOKEN=!ChangeMe!

MAIN_ADMIN_PASSWORD=!ChangeMe!
ALINA_ADMIN_PASSWORD=!ChangeMe!
LUDA_ADMIN_PASSWORD=!ChangeMe!

# Debt amount above which an account is blocked from booking (UAH).
DEBT_BLOCK_THRESHOLD=1300

# Telegram file_id for each pavilion image, populated once via
# `bin/console bot:upload-pavilion-photos <chat_id>`. Empty values fall
# back to slow file uploads, so set these to keep /hook fast.
PAVILION1_PHOTO_FILE_ID=
PAVILION2_PHOTO_FILE_ID=

# Residents' Telegram group («ЖК City Park • Черкаси»). RESIDENT_CHAT_ID is the
# supergroup id (negative, -100…) and must be re-read after Telegram converts the
# basic group into a supergroup — the id changes. The link is the join-request one
# created by `bin/console resident-chat:link`; it is safe to publish, since every
# request is vetted against the ОСББ registry before anyone gets in.
RESIDENT_CHAT_ID=
RESIDENT_CHAT_INVITE_LINK=

# Telegram ids that may move a complaint's status (head of the ОСББ). Comma-separated.
# Empty means nobody can — the register still accepts reports, they just stay 🆕.
COMPLAINT_MANAGER_TELEGRAM_IDS=

# Where the nightly database dump is delivered — a Telegram chat id, normally the
# owner's own. The point of a backup is that it does not live on the machine it is
# protecting against, and Telegram is a second place that needs no SMTP credentials and
# is reachable from any phone. Empty means "keep the dump on disk only".
BACKUP_TELEGRAM_CHAT_ID=

# Second delivery address for the nightly dump — an ordinary mail attachment over
# MAILER_DSN. Telegram and the server can be lost in the same afternoon; mail is a
# different kind of place. Empty means "Telegram only".
BACKUP_EMAIL=
